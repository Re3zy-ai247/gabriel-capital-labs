  @@unique([tenantId, consumerId, confirmedIdentityBaselineId, ordinal], map: "identity_baseline_account_review_ordinal_key")
  @@index([tenantId, consumerId, reportVersionId, confirmedIdentityBaselineId], map: "identity_baseline_account_review_baseline_idx")
}

// Recipient identity and, for a CRA, its exact bureau authority are stable;
// consumer/personally identifying display data is encrypted. Non-CRA recipients
// retain item-level bureau provenance and therefore carry no recipient bureau.
model Recipient {
  id                         String               @id @default(cuid())
  tenantId                   String
  consumerId                 String
  scope                      CreditTruthScope     @relation(fields: [tenantId, consumerId], references: [tenantId, consumerId], onDelete: Restrict, onUpdate: Restrict)
  stableKey                  String
  recipientType              RecipientType
  bureau                     Bureau?
  displayNameCiphertext      Bytes?
  displayNameIv              Bytes?
  displayNameAuthTag         Bytes?
  displayNameKeyVersion      String?
  displayNameAlgorithm       EncryptionAlgorithm?
  displayNameEnvelopeVersion String?
  displayNameAadVersion      String?
  createdAt                  DateTime             @default(now())

  addressVersions RecipientAddressVersion[]
  correspondences Correspondence[]
  packets         Packet[]
  artifacts       Artifact[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, stableKey])
  @@index([tenantId, consumerId, recipientType])
}

// The entire postal address is one authenticated encrypted envelope. No postal
// component, recipient name, or address hash is indexed.
model RecipientAddressVersion {
  id                     String                 @id @default(cuid())
  tenantId               String
  consumerId             String
  recipientId            String
  recipient              Recipient              @relation(fields: [tenantId, consumerId, recipientId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict)
  addressSeriesKey       String
  version                Int
  status                 RecipientAddressStatus
  addressCiphertext      Bytes
  addressIv              Bytes
  addressAuthTag         Bytes
  addressKeyVersion      String
  addressAlgorithm       EncryptionAlgorithm
  addressEnvelopeVersion String
  addressAadVersion      String
  validationRuleKey      String
  validationRuleVersion  String
  validationResultCode   String?
  effectiveAt            DateTime
  createdByActorId       String
  createdAt              DateTime               @default(now())

  correspondences        Correspondence[]
  correspondenceVersions CorrespondenceVersion[]
  packets                Packet[]
  artifacts              Artifact[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, recipientId, id])
  @@unique([tenantId, consumerId, recipientId, addressSeriesKey, version])
  @@index([tenantId, consumerId, recipientId, status, effectiveAt])
}

model DisputeCase {
  id               String            @id @default(cuid())
  tenantId         String
  consumerId       String
  reportVersionId  String
  reportVersion    ReportVersion     @relation(fields: [tenantId, consumerId, reportVersionId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict)
  caseKey          String
  status           DisputeCaseStatus @default(DRAFT)
  policyVersion    String
  openedAt         DateTime          @default(now())
  closedAt         DateTime?
  createdByActorId String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  correspondences Correspondence[]
  packets         Packet[]
  artifacts       Artifact[]
  evidenceEvents  EvidenceEvent[]
  disputeOutcomes DisputeOutcome[]
  actionDecisions CaseActionDecision[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, reportVersionId, id])
  @@unique([tenantId, consumerId, caseKey])
  @@index([tenantId, consumerId, status, createdAt])
}

// Append-only consumer selection chronology. No policy, counsel disposition,
// legal eligibility, correspondence content, or requested legal conclusion is
// stored here. Exact source memberships are normalized below.
model CaseActionDecision {
  id                   String                  @id @default(cuid())
  tenantId             String
  consumerId           String
  reportVersionId      String
  caseId               String
  disputeCase          DisputeCase             @relation(fields: [tenantId, consumerId, reportVersionId, caseId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict, map: "CaseActionDecision_case_fkey")
  decisionSeriesKey    String
  version              Int
  state                CaseActionDecisionState
  actionCode           CaseActionCode
  chronologyRound      Int
  expectedSourceCount  Int
  sourceSetSha256      String                  @db.VarChar(64)
  idempotencyKey       String
  recordedByActorId    String
  recordedAt           DateTime
  supersedesDecisionId String?
  supersedes           CaseActionDecision?     @relation("CaseActionDecisionSupersession", fields: [tenantId, consumerId, decisionSeriesKey, supersedesDecisionId], references: [tenantId, consumerId, decisionSeriesKey, id], onDelete: Restrict, onUpdate: Restrict, map: "case_action_decision_supersession_fkey")
  supersededBy         CaseActionDecision[]    @relation("CaseActionDecisionSupersession")
  createdAt            DateTime                @default(now())

  sourceRefs CaseActionSourceRef[]

  @@unique([tenantId, consumerId, id], map: "case_action_decision_scope_id_key")
  @@unique([tenantId, consumerId, reportVersionId, caseId, id], map: "case_action_decision_membership_pin_key")
  @@unique([tenantId, consumerId, decisionSeriesKey, id], map: "case_action_decision_supersession_key")
  @@unique([tenantId, consumerId, decisionSeriesKey, version], map: "case_action_decision_series_version_key")
  @@unique([tenantId, consumerId, idempotencyKey], map: "case_action_decision_idempotency_key")
  @@unique([tenantId, consumerId, supersedesDecisionId], map: "case_action_decision_single_successor_key")
  @@index([tenantId, consumerId, caseId, state, recordedAt], map: "case_action_decision_case_state_idx")
}

// Closed, normalized exact source membership for both proposed and consumer-
// selected decisions. A database trigger resolves and locks the type-specific
// source row in the same scope/report and verifies version, bureau, and digest.
model CaseActionSourceRef {
  id              String               @id @default(cuid())
  tenantId        String
  consumerId      String
  reportVersionId String
  caseId          String
  decisionId      String
  decision        CaseActionDecision   @relation(fields: [tenantId, consumerId, reportVersionId, caseId, decisionId], references: [tenantId, consumerId, reportVersionId, caseId, id], onDelete: Restrict, onUpdate: Restrict, map: "case_action_source_decision_fkey")
  sourceType      CaseActionSourceType
  sourceId        String
  sourceVersion   Int
  bureau          Bureau?
  integritySha256 String               @db.VarChar(64)
  ordinal         Int
  createdAt       DateTime             @default(now())

  @@unique([tenantId, consumerId, id], map: "case_action_source_scope_id_key")
  @@unique([tenantId, consumerId, decisionId, sourceType, sourceId], map: "case_action_source_membership_key")
  @@unique([tenantId, consumerId, decisionId, ordinal], map: "case_action_source_ordinal_key")
  @@index([tenantId, consumerId, sourceType, sourceId], map: "case_action_source_lookup_idx")
}

// Mutable aggregate header only. Approved content, addresses, items and artifacts
// are pinned in immutable version rows below.
model Correspondence {
  id                        String                  @id @default(cuid())
  tenantId                  String
  consumerId                String
  reportVersionId           String
  caseId                    String
  disputeCase               DisputeCase             @relation(fields: [tenantId, consumerId, reportVersionId, caseId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict)
  recipientId               String
  recipient                 Recipient               @relation(fields: [tenantId, consumerId, recipientId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict)
  recipientAddressVersionId String
  recipientAddressVersion   RecipientAddressVersion @relation(fields: [tenantId, consumerId, recipientId, recipientAddressVersionId], references: [tenantId, consumerId, recipientId, id], onDelete: Restrict, onUpdate: Restrict)
  identityBaselineId        String
  identityBaseline          IdentityBaseline        @relation(fields: [tenantId, consumerId, reportVersionId, identityBaselineId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict)
  strategyKey               String
  claimClass                String
  policyVersion             String
  round                     Int
  status                    CorrespondenceStatus    @default(DRAFT)
  idempotencyKey            String
  parentCorrespondenceId    String?
  parentRound               Int?
  parentLineageRef          String
  parentCorrespondence      Correspondence?         @relation("CorrespondenceRounds", fields: [tenantId, consumerId, reportVersionId, caseId, recipientId, identityBaselineId, policyVersion, claimClass, parentRound, parentCorrespondenceId], references: [tenantId, consumerId, reportVersionId, caseId, recipientId, identityBaselineId, policyVersion, claimClass, round, id], onDelete: Restrict, onUpdate: Restrict)
  childCorrespondence       Correspondence[]        @relation("CorrespondenceRounds")
  createdByActorId          String
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  items    CorrespondenceItem[]
  versions CorrespondenceVersion[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, reportVersionId, caseId, id])
  @@unique([tenantId, consumerId, reportVersionId, caseId, recipientId, recipientAddressVersionId, identityBaselineId, strategyKey, claimClass, policyVersion, round, parentLineageRef, id], map: "correspondence_version_pin_key")
  @@unique([tenantId, consumerId, reportVersionId, caseId, recipientId, identityBaselineId, policyVersion, claimClass, round, id], map: "correspondence_parent_pin_key")
  @@unique([tenantId, consumerId, idempotencyKey])
  @@index([tenantId, consumerId, caseId, recipientId, round])
}

// Immutable exact-field claim. It cannot exist without a same-report observation,
// assessment and consumer assertion; historical evidence is optionally pinned.
model CorrespondenceItem {
  id                         String                   @id @default(cuid())
  tenantId                   String
  consumerId                 String
  reportVersionId            String
  caseId                     String
  correspondenceId           String
  correspondence             Correspondence           @relation(fields: [tenantId, consumerId, reportVersionId, caseId, correspondenceId], references: [tenantId, consumerId, reportVersionId, caseId, id], onDelete: Restrict, onUpdate: Restrict)
  accountId                  String
  extractionRunId            String
  bureau                     Bureau
  fieldKey                   String
  observationId              String
  observationSeriesKey       String
  observationRevision        Int
  observationIntegritySha256 String                   @db.VarChar(64)
  observation                FieldObservation         @relation(fields: [tenantId, consumerId, reportVersionId, accountId, extractionRunId, bureau, fieldKey, observationSeriesKey, observationRevision, observationIntegritySha256, observationId], references: [tenantId, consumerId, reportVersionId, accountId, extractionRunId, bureau, fieldKey, observationSeriesKey, revision, integritySha256, id], onDelete: Restrict, onUpdate: Restrict, map: "correspondence_item_observation_fkey")
  historicalEvidenceId       String?
  historicalEvidence         HistoricalEvidence?      @relation(fields: [tenantId, consumerId, reportVersionId, accountId, extractionRunId, bureau, historicalEvidenceId], references: [tenantId, consumerId, reportVersionId, accountId, extractionRunId, bureau, id], onDelete: Restrict, onUpdate: Restrict, map: "correspondence_item_history_fkey")
  assessmentId               String
  assessment                 DerivedAccountAssessment @relation(fields: [tenantId, consumerId, reportVersionId, accountId, extractionRunId, assessmentId], references: [tenantId, consumerId, reportVersionId, accountId, extractionRunId, id], onDelete: Restrict, onUpdate: Restrict, map: "correspondence_item_assessment_fkey")
  consumerAssertionId        String
  consumerAssertion          ConsumerAssertion        @relation(fields: [tenantId, consumerId, reportVersionId, accountId, extractionRunId, bureau, fieldKey, observationSeriesKey, observationRevision, observationIntegritySha256, observationId, assessmentId, consumerAssertionId], references: [tenantId, consumerId, reportVersionId, accountId, extractionRunId, bureau, fieldKey, observationSeriesKey, observationRevision, observationIntegritySha256, observationId, assessmentId, id], onDelete: Restrict, onUpdate: Restrict, map: "correspondence_item_assertion_fkey")
  itemKey                    String
  ordinal                    Int
  claimType                  String
  createdAt                  DateTime                 @default(now())

  versionMemberships CorrespondenceVersionItem[]
  disputeOutcomes    DisputeOutcome[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, reportVersionId, caseId, correspondenceId, id])
  @@unique([tenantId, consumerId, reportVersionId, caseId, correspondenceId, accountId, bureau, fieldKey, consumerAssertionId, id], map: "correspondence_item_outcome_pin_key")
  @@unique([tenantId, consumerId, correspondenceId, itemKey])
  @@unique([tenantId, consumerId, correspondenceId, ordinal])
  @@index([tenantId, consumerId, observationId])
  @@index([tenantId, consumerId, consumerAssertionId])
}

// Approved/draft content versions are always appended. Approval is a property of
// the inserted version, not a later in-place status mutation.
model CorrespondenceVersion {
  id                        String                  @id @default(cuid())
  tenantId                  String
  consumerId                String
  reportVersionId           String
  caseId                    String
  correspondenceId          String
  correspondence            Correspondence          @relation(fields: [tenantId, consumerId, reportVersionId, caseId, recipientId, recipientAddressVersionId, identityBaselineId, strategyKey, claimClass, policyVersion, round, parentLineageRef, correspondenceId], references: [tenantId, consumerId, reportVersionId, caseId, recipientId, recipientAddressVersionId, identityBaselineId, strategyKey, claimClass, policyVersion, round, parentLineageRef, id], onDelete: Restrict, onUpdate: Restrict, map: "correspondence_version_correspondence_fkey")
  version                   Int
  status                    CorrespondenceStatus
  strategyKey               String
  claimClass                String
  policyVersion             String
  round                     Int
  parentLineageRef          String
  templateVersion           String
  recipientId               String
  recipientAddressVersionId String
  recipientAddressVersion   RecipientAddressVersion @relation(fields: [tenantId, consumerId, recipientId, recipientAddressVersionId], references: [tenantId, consumerId, recipientId, id], onDelete: Restrict, onUpdate: Restrict)
  identityBaselineId        String
  identityBaseline          IdentityBaseline        @relation(fields: [tenantId, consumerId, reportVersionId, identityBaselineId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict, map: "correspondence_version_identity_fkey")
  bodyCiphertext            Bytes
  bodyIv                    Bytes
  bodyAuthTag               Bytes
  bodyKeyVersion            String
  bodyAlgorithm             EncryptionAlgorithm
  bodyEnvelopeVersion       String
  bodyAadVersion            String
  bodySha256                String                  @db.VarChar(64)
  itemSetSha256             String                  @db.VarChar(64)
  itemCount                 Int                     @default(0)
  supersedesVersionId       String?
  supersedesVersion         CorrespondenceVersion?  @relation("CorrespondenceVersionSupersession", fields: [tenantId, consumerId, reportVersionId, caseId, correspondenceId, supersedesVersionId], references: [tenantId, consumerId, reportVersionId, caseId, correspondenceId, id], onDelete: Restrict, onUpdate: Restrict)
  supersededBy              CorrespondenceVersion[] @relation("CorrespondenceVersionSupersession")
  approvedByActorId         String?
  approvedAt                DateTime?
  createdByActorId          String
  createdAt                 DateTime                @default(now())

  itemMemberships     CorrespondenceVersionItem[]
  packetMemberships   PacketCorrespondenceVersion[]
  primaryArtifacts    Artifact[]                      @relation("ArtifactPrimaryCorrespondenceVersion")
  artifactMemberships ArtifactCorrespondenceVersion[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, reportVersionId, caseId, correspondenceId, id])
  @@unique([tenantId, consumerId, reportVersionId, caseId, correspondenceId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, id], map: "correspondence_version_packet_pin_key")
  @@unique([tenantId, consumerId, correspondenceId, version])
  @@index([tenantId, consumerId, caseId, status, createdAt])
}

model CorrespondenceVersionItem {
  id                      String                @id @default(cuid())
  tenantId                String
  consumerId              String
  reportVersionId         String
  caseId                  String
  correspondenceId        String
  correspondenceVersionId String
  correspondenceVersion   CorrespondenceVersion @relation(fields: [tenantId, consumerId, reportVersionId, caseId, correspondenceId, correspondenceVersionId], references: [tenantId, consumerId, reportVersionId, caseId, correspondenceId, id], onDelete: Restrict, onUpdate: Restrict, map: "cvi_version_fkey")
  correspondenceItemId    String
  correspondenceItem      CorrespondenceItem    @relation(fields: [tenantId, consumerId, reportVersionId, caseId, correspondenceId, correspondenceItemId], references: [tenantId, consumerId, reportVersionId, caseId, correspondenceId, id], onDelete: Restrict, onUpdate: Restrict, map: "cvi_item_fkey")
  ordinal                 Int
  createdAt               DateTime              @default(now())

  disputeOutcomes DisputeOutcome[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, correspondenceVersionId, correspondenceItemId], map: "cvi_version_item_key")
  @@unique([tenantId, consumerId, correspondenceVersionId, ordinal], map: "cvi_version_ordinal_key")
  @@unique([tenantId, consumerId, reportVersionId, caseId, correspondenceId, correspondenceVersionId, correspondenceItemId, id], map: "cvi_outcome_pin_key")
}

// One immutable recipient-first packet version; multiple correspondence versions
// may be consolidated only through the explicit membership table.
model Packet {
  id                         String                  @id @default(cuid())
  tenantId                   String
  consumerId                 String
  reportVersionId            String
  caseId                     String
  disputeCase                DisputeCase             @relation(fields: [tenantId, consumerId, reportVersionId, caseId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict)
  recipientId                String
  recipient                  Recipient               @relation(fields: [tenantId, consumerId, recipientId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict)
  recipientAddressVersionId  String
  recipientAddressVersion    RecipientAddressVersion @relation(fields: [tenantId, consumerId, recipientId, recipientAddressVersionId], references: [tenantId, consumerId, recipientId, id], onDelete: Restrict, onUpdate: Restrict)
  identityBaselineId         String
  identityBaseline           IdentityBaseline        @relation(fields: [tenantId, consumerId, reportVersionId, identityBaselineId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict)
  packetSeriesKey            String
  version                    Int
  round                      Int
  claimClass                 String
  policyVersion              String
  enclosureManifestSha256    String                  @db.VarChar(64)
  correspondenceVersionCount Int                     @default(0)
  enclosureCount             Int                     @default(0)
  status                     PacketStatus
  approvedByActorId          String?
  approvedAt                 DateTime?
  createdByActorId           String
  createdAt                  DateTime                @default(now())

  correspondenceVersions PacketCorrespondenceVersion[]
  enclosures             PacketEnclosure[]
  artifacts              Artifact[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, reportVersionId, caseId, id])
  @@unique([tenantId, consumerId, reportVersionId, caseId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, id], map: "packet_artifact_pin_key")
  @@unique([tenantId, consumerId, packetSeriesKey, version])
  @@index([tenantId, consumerId, caseId, recipientId, round])
}

model PacketCorrespondenceVersion {
  id                        String                @id @default(cuid())
  tenantId                  String
  consumerId                String
  reportVersionId           String
  caseId                    String
  recipientId               String
  recipientAddressVersionId String
  identityBaselineId        String
  policyVersion             String
  round                     Int
  claimClass                String
  packetId                  String
  packet                    Packet                @relation(fields: [tenantId, consumerId, reportVersionId, caseId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, packetId], references: [tenantId, consumerId, reportVersionId, caseId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, id], onDelete: Restrict, onUpdate: Restrict, map: "pcv_packet_fkey")
  correspondenceId          String
  correspondenceVersionId   String
  correspondenceVersion     CorrespondenceVersion @relation(fields: [tenantId, consumerId, reportVersionId, caseId, correspondenceId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, correspondenceVersionId], references: [tenantId, consumerId, reportVersionId, caseId, correspondenceId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, id], onDelete: Restrict, onUpdate: Restrict, map: "pcv_correspondence_version_fkey")
  ordinal                   Int
  createdAt                 DateTime              @default(now())

  primaryArtifacts               Artifact[]                      @relation("ArtifactPrimaryPacketMembership")
  artifactCorrespondenceVersions ArtifactCorrespondenceVersion[] @relation("ArtifactCorrespondencePacketMembership")

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, packetId, correspondenceVersionId])
  @@unique([tenantId, consumerId, reportVersionId, caseId, packetId, correspondenceId, correspondenceVersionId], map: "pcv_artifact_membership_key")
  @@unique([tenantId, consumerId, packetId, ordinal])
}

// One exact packet-bound enclosure membership. Artifact metadata must carry the
// same packet, recipient/address, identity, policy, round and claim pins; reusable
// storage bytes require a separate immutable Artifact row for each packet context.
model PacketEnclosure {
  id                        String              @id @default(cuid())
  tenantId                  String
  consumerId                String
  reportVersionId           String
  caseId                    String
  recipientId               String
  recipientAddressVersionId String
  identityBaselineId        String
  policyVersion             String
  round                     Int
  claimClass                String
  packetId                  String
  packet                    Packet              @relation(fields: [tenantId, consumerId, reportVersionId, caseId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, packetId], references: [tenantId, consumerId, reportVersionId, caseId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, id], onDelete: Restrict, onUpdate: Restrict, map: "packet_enclosure_packet_fkey")
  artifactId                String
  artifactKind              ArtifactKind
  artifact                  Artifact            @relation(fields: [tenantId, consumerId, reportVersionId, caseId, packetId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, artifactKind, artifactId], references: [tenantId, consumerId, reportVersionId, caseId, packetId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, kind, id], onDelete: Restrict, onUpdate: Restrict, map: "packet_enclosure_artifact_fkey")
  ordinal                   Int
  kind                      PacketEnclosureKind
  labelCode                 String
  required                  Boolean             @default(false)
  createdAt                 DateTime            @default(now())

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, packetId, artifactId])
  @@unique([tenantId, consumerId, packetId, ordinal])
}

// Vendor-neutral immutable object metadata. The provider key is configuration,
// while the provider locator is encrypted. No public URL is stored. Packet and
// correspondence joins pin domain versions without binding storage to a vendor.
model Artifact {
  id                             String                       @id @default(cuid())
  tenantId                       String
  consumerId                     String
  scope                          CreditTruthScope             @relation(fields: [tenantId, consumerId], references: [tenantId, consumerId], onDelete: Restrict, onUpdate: Restrict)
  artifactSeriesKey              String
  version                        Int
  kind                           ArtifactKind
  reportVersionId                String?
  reportVersion                  ReportVersion?               @relation("ArtifactReportVersion", fields: [tenantId, consumerId, reportVersionId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict)
  caseId                         String?
  disputeCase                    DisputeCase?                 @relation(fields: [tenantId, consumerId, reportVersionId, caseId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict)
  packetId                       String?
  packet                         Packet?                      @relation(fields: [tenantId, consumerId, reportVersionId, caseId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, packetId], references: [tenantId, consumerId, reportVersionId, caseId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, id], onDelete: Restrict, onUpdate: Restrict)
  primaryCorrespondenceId        String?
  primaryCorrespondenceVersionId String?
  primaryCorrespondenceVersion   CorrespondenceVersion?       @relation("ArtifactPrimaryCorrespondenceVersion", fields: [tenantId, consumerId, reportVersionId, caseId, primaryCorrespondenceId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, primaryCorrespondenceVersionId], references: [tenantId, consumerId, reportVersionId, caseId, correspondenceId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, id], onDelete: Restrict, onUpdate: Restrict)
  primaryPacketMembership        PacketCorrespondenceVersion? @relation("ArtifactPrimaryPacketMembership", fields: [tenantId, consumerId, reportVersionId, caseId, packetId, primaryCorrespondenceId, primaryCorrespondenceVersionId], references: [tenantId, consumerId, reportVersionId, caseId, packetId, correspondenceId, correspondenceVersionId], onDelete: Restrict, onUpdate: Restrict, map: "artifact_primary_packet_membership_fkey")
  recipientId                    String?
  recipient                      Recipient?                   @relation(fields: [tenantId, consumerId, recipientId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict)
  recipientAddressVersionId      String?
  recipientAddressVersion        RecipientAddressVersion?     @relation(fields: [tenantId, consumerId, recipientId, recipientAddressVersionId], references: [tenantId, consumerId, recipientId, id], onDelete: Restrict, onUpdate: Restrict)
  identityBaselineId             String?
  identityBaseline               IdentityBaseline?            @relation(fields: [tenantId, consumerId, reportVersionId, identityBaselineId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict)
  storageProviderKey             String
  storageLocatorCiphertext       Bytes
  storageLocatorIv               Bytes
  storageLocatorAuthTag          Bytes
  storageLocatorKeyVersion       String
  storageLocatorAlgorithm        EncryptionAlgorithm
  storageLocatorEnvelopeVersion  String
  storageLocatorAadVersion       String
  sha256                         String                       @db.VarChar(64)
  mimeType                       String
  byteLength                     BigInt
  pageCount                      Int?
  rendererVersion                String?
  templateVersion                String?
  policyVersion                  String?
  round                          Int?
  claimClass                     String?
  enclosureManifestSha256        String?                      @db.VarChar(64)
  correspondenceVersionCount     Int                          @default(0)
  createdByActorId               String
  createdAt                      DateTime                     @default(now())

  enclosureMemberships   PacketEnclosure[]
  correspondenceVersions ArtifactCorrespondenceVersion[]
  tombstones             ArtifactTombstone[]
  sourceReportIngestions ReportIngestion[]               @relation("ReportIngestionSourceArtifact")
  extractionInputRuns    ExtractionRun[]                 @relation("ExtractionRunInputArtifact")

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, id, sha256], map: "artifact_extraction_input_pin_key")
  @@unique([tenantId, consumerId, reportVersionId, caseId, id])
  @@unique([tenantId, consumerId, reportVersionId, caseId, kind, id], map: "artifact_enclosure_pin_key")
  @@unique([tenantId, consumerId, reportVersionId, caseId, packetId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, kind, id], map: "artifact_packet_enclosure_pin_key")
  @@unique([tenantId, consumerId, reportVersionId, caseId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, id], map: "artifact_correspondence_pin_key")
  @@unique([tenantId, consumerId, artifactSeriesKey, version])
  @@index([tenantId, consumerId, kind, createdAt])
  @@index([tenantId, consumerId, sha256])
  @@index([tenantId, consumerId, packetId])
}

model ArtifactCorrespondenceVersion {
  id                        String                       @id @default(cuid())
  tenantId                  String
  consumerId                String
  reportVersionId           String
  caseId                    String
  recipientId               String
  recipientAddressVersionId String
  identityBaselineId        String
  policyVersion             String
  round                     Int
  claimClass                String
  packetId                  String?
  packetMembership          PacketCorrespondenceVersion? @relation("ArtifactCorrespondencePacketMembership", fields: [tenantId, consumerId, reportVersionId, caseId, packetId, correspondenceId, correspondenceVersionId], references: [tenantId, consumerId, reportVersionId, caseId, packetId, correspondenceId, correspondenceVersionId], onDelete: Restrict, onUpdate: Restrict, map: "acv_packet_membership_fkey")
  artifactId                String
  artifact                  Artifact                     @relation(fields: [tenantId, consumerId, reportVersionId, caseId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, artifactId], references: [tenantId, consumerId, reportVersionId, caseId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, id], onDelete: Restrict, onUpdate: Restrict, map: "acv_artifact_fkey")
  correspondenceId          String
  correspondenceVersionId   String
  correspondenceVersion     CorrespondenceVersion        @relation(fields: [tenantId, consumerId, reportVersionId, caseId, correspondenceId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, correspondenceVersionId], references: [tenantId, consumerId, reportVersionId, caseId, correspondenceId, recipientId, recipientAddressVersionId, identityBaselineId, policyVersion, round, claimClass, id], onDelete: Restrict, onUpdate: Restrict, map: "acv_correspondence_version_fkey")
  ordinal                   Int
  createdAt                 DateTime                     @default(now())

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, artifactId, correspondenceVersionId], map: "acv_artifact_version_key")
  @@unique([tenantId, consumerId, artifactId, ordinal], map: "acv_artifact_ordinal_key")
}

// Artifact erasure/retention is an appended request/result record. The immutable
// Artifact stays as digest evidence while its encrypted object/key may be destroyed.
model ArtifactTombstone {
  id                 String   @id @default(cuid())
  tenantId           String
  consumerId         String
  artifactId         String
  artifact           Artifact @relation(fields: [tenantId, consumerId, artifactId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict)
  eventKey           String
  eventType          String // TOMBSTONE_REQUESTED | OBJECT_DELETED | CRYPTO_SHREDDED | FAILED
  reasonCode         String
  storageDeletionRef String?
  actorId            String
  occurredAt         DateTime
  createdAt          DateTime @default(now())

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, eventKey])
  @@index([tenantId, consumerId, artifactId, createdAt])
}

// Refs-only access-decision ledger. No report values, testimony, addresses,
// snippets, provider errors, or arbitrary metadata are permitted.
model P0SensitiveAccessEvent {
  id                   String                       @id @default(cuid())
  tenantId             String
  consumerId           String
  scope                CreditTruthScope             @relation(fields: [tenantId, consumerId], references: [tenantId, consumerId], onDelete: Restrict, onUpdate: Restrict)
  eventKey             String
  actorId              String
  authorizationKind    P0AuthorizationKind
  authorizationVersion String
  accessKind           P0SensitiveAccessKind
  purposeCode          P0SensitiveAccessPurposeCode
  decision             P0SensitiveAccessDecision
  decisionCode         P0SensitiveAccessReasonCode
  resourceType         P0SensitiveResourceType
  resourceId           String
  resourceVersion      Int
  correlationId        String
  occurredAt           DateTime
  createdAt            DateTime                     @default(now())

  @@unique([tenantId, consumerId, id], map: "p0_sensitive_access_scope_id_key")
  @@unique([tenantId, consumerId, eventKey], map: "p0_sensitive_access_event_key")
  @@index([tenantId, consumerId, resourceType, resourceId, resourceVersion], map: "p0_sensitive_access_resource_idx")
  @@index([tenantId, consumerId, actorId, occurredAt, id], map: "p0_sensitive_access_actor_idx")
  @@index([tenantId, consumerId, correlationId], map: "p0_sensitive_access_correlation_idx")
}

// PII-safe append-only ledger: internal refs and bounded machine keys only. There
// is deliberately no free-text or JSON value payload.
model EvidenceEvent {
  id             String               @id @default(cuid())
  tenantId       String
  consumerId     String
  scope          CreditTruthScope     @relation(fields: [tenantId, consumerId], references: [tenantId, consumerId], onDelete: Restrict, onUpdate: Restrict)
  caseId         String?
  disputeCase    DisputeCase?         @relation(fields: [tenantId, consumerId, caseId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict)
  eventKey       String
  eventType      EvidenceEventType
  eventVersion   Int
  subjectType    EvidenceSubjectType
  subjectId      String
  relatedRefType EvidenceSubjectType?
  relatedRefId   String?
  actorId        String
  correlationId  String
  occurredAt     DateTime
  createdAt      DateTime             @default(now())

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, eventKey])
  @@index([tenantId, consumerId, occurredAt, id])
  @@index([tenantId, consumerId, caseId, occurredAt, id])
  @@index([tenantId, consumerId, subjectType, subjectId])
  @@index([tenantId, consumerId, correlationId])
}
