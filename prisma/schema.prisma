  identityFactSeriesKey       String
  identityFactId              String
  identityFactClassification  IdentityFactClassification
  identityFactIntegritySha256 String                                @db.VarChar(64)
  identityFact                IdentityFact                          @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId, identityBaselineId, baselineInputSetSha256, identityFactSeriesKey, identityFactId, identityFactClassification, identityFactIntegritySha256], references: [tenantId, consumerId, reportVersionId, extractionRunId, identityBaselineId, baselineInputSetSha256, factSeriesKey, id, classification, integritySha256], onDelete: Restrict, onUpdate: Restrict, map: "identity_correspondence_assertion_fact_fkey")
  factBureau                  Bureau?
  factSourceLocatorToken      String
  correspondencePurposeCode   IdentityCorrespondencePurpose
  sourceSeriesKey             String                                @db.VarChar(64)
  assertionSeriesKey          String
