// Gabriel Capital Labs — data model
// Note the per-bureau presence model (PRESENT / ABSENT / UNKNOWN) which prevents
// the app from ever asserting what a bureau reports when that bureau's data was
// never uploaded. This is the core accuracy guarantee of the platform.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Bureau {
  EQUIFAX
  EXPERIAN
  TRANSUNION
}

enum AccountType {
  REVOLVING // credit cards (original creditor)
  INSTALLMENT // auto / personal loans (original creditor)
  MORTGAGE
  COLLECTION // third-party / debt-buyer collection
  CHARGE_OFF
  STUDENT_LOAN
  PUBLIC_RECORD
  INQUIRY
  GOVERNMENT // child support, tax, benefit overpayment — generally NON-disputable
  OTHER
}

enum Probability {
  HIGH
  MEDIUM
  LOW
  NOT_RECOMMENDED // government / non-strategic items
}

enum UserRole {
  USER
  ADMIN
}

enum LetterStatus {
  DRAFT
  GENERATED
  PRINTED
  MAILED
  RESPONSE_RECEIVED
  RESOLVED
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  username             String?           @unique // optional login handle (e.g. "ceogabriel")
  name                 String?
  passwordHash         String?
  // Admin & subscription
  role                 UserRole          @default(USER)
  disabled             Boolean           @default(false) // admin can disable an account (blocks login)
  // Monotonic authorization epoch for P0 principals. A database trigger owns
  // this value and increments it whenever an authorization-bearing User field
  // changes, preventing revoke/regrant ABA from reviving an older principal.
  p0AuthorizationRevision Int            @default(1)
  briefDigest          Boolean           @default(false) // opted in to the weekly CreditVector Brief email digest
  letterCredits        Int               @default(0) // one-time letter-pack credits (consumed past the free monthly allowance)
  // Billing — Stripe subscription state. plan is the source of truth for entitlements.
  plan                 String            @default("free") // "free" | "premium"
  stripeCustomerId     String?           @unique
  stripeSubscriptionId String?
  subscriptionStatus   String? // active | trialing | past_due | canceled | incomplete | ...
  currentPeriodEnd     DateTime?
  // Consumer info required before a letter can be finalized/printed
  fullName             String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  zip                  String?
  createdAt            DateTime          @default(now())
  reports              Report[]
  tradelines           Tradeline[]
  letters              Letter[]
  scoreEntries         ScoreEntry[]
  documents            Document[]
  communityThreads     CommunityThread[]
  communityReplies     CommunityReply[]
  supportTickets       SupportTicket[]

  // ---- Agency tier ($399/mo): an agency manages many "clients" on their behalf.
  // A managed client is itself a User row with managedByAgencyId set and no
  // password (cannot log in directly); the agency works inside the client's
  // workspace. isAgency marks an account as an agency; agencyName is its brand.
  isAgency          Boolean @default(false)
  agencyName        String?
  managedByAgencyId String?
  managedByAgency   User?   @relation("AgencyClients", fields: [managedByAgencyId], references: [id], onDelete: Cascade)
  managedClients    User[]  @relation("AgencyClients")

  networkMessages     NetworkMessage[]          @relation("NetworkMessages")
  networkMessageReads NetworkMessageReadState[] @relation("NetworkMessageReads")

  // ---- Operator Identity (Sprint 9). Additive back-relations only (no new column
  // on User): the auth User stays the source of truth; OperatorIdentity is the
  // platform-identity projection keyed to the account, and Organization is the
  // durable org an account owns. Dormant behind OPERATOR_IDENTITY_ENABLED.
  operatorIdentity   OperatorIdentity?
  ownedOrganizations Organization[]    @relation("OrganizationOwner")

  // P0 credit-truth ownership. A direct consumer uses the same User id for both
  // sides; an agency workspace uses the agency as tenant and its managed User as
  // consumer. CreditTruthScope creation is authorization-gated in application
  // code, and every sensitive P0 row repeats this pair for tenant-safe joins.
  creditTruthTenantScopes   CreditTruthScope[] @relation("CreditTruthTenant")
  creditTruthConsumerScopes CreditTruthScope[] @relation("CreditTruthConsumer")
}

// Append-only record of privileged admin actions (discount codes created, plans
// comped, roles changed, impersonation started, accounts disabled, etc.).
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String // the admin who performed the action
  actorEmail String
  action     String // machine key, e.g. "discount.create" | "user.comp_plan" | "user.impersonate"
  targetType String? // "user" | "discount" | "agency" | ...
  targetId   String?
  summary    String // human-readable one-liner
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Admin broadcast shown as a banner to all users. Typically one active at a time.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  tone      String   @default("info") // "info" | "success" | "warning"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active])
}

enum DocType {
  GOV_ID_FRONT
  GOV_ID_BACK
  SSN_CARD
  PROOF_OF_ADDRESS
  UTILITY_BILL
}

// Identity/verification documents the consumer uploads (government ID, proof of
// address, etc.). File bytes are encrypted at rest with AES-256-GCM (lib/docCrypto.ts)
// and are NEVER served from a public URL — only streamed back through an
// authenticated route that verifies ownership. includeInLetters controls whether
// the document is referenced/attached in generated dispute packets. SSN cards
// default to excluded; only enable when a bureau specifically requires it.
model Document {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             DocType
  filename         String
  mimeType         String
  // AES-256-GCM ciphertext plus per-record IV and authentication tag (raw bytes).
  ciphertext       Bytes
  iv               Bytes
  authTag          Bytes
  byteSize         Int // size of the original plaintext, for display
  includeInLetters Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@unique([userId, type])
  @@index([userId])
}

// Audit row written when an agency deletes a managed client, so the agency KPI
// report can show accounts-deleted by period (WTD / MTD / YTD).
model AgencyClientDeletion {
  id         String   @id @default(cuid())
  agencyId   String
  clientName String?
  deletedAt  DateTime @default(now())

  @@index([agencyId])
}

// User-logged credit scores over time (manual entry — we don't pull live scores).
model ScoreEntry {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  bureau     Bureau
  score      Int
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Report {
  id         String          @id @default(cuid())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  fileName   String
  // Which bureaus this uploaded report actually covered.
  bureaus    Bureau[]
  rawText    String?         @db.Text // stored so a report can be re-analyzed
  uploadedAt DateTime        @default(now())
  analyzedAt DateTime?
  tradelines Tradeline[]
  p0Versions ReportVersion[]

  // Additive composite key used only by P0 same-consumer provenance FKs.
  @@unique([userId, id], map: "Report_userId_id_p0_key")
}

model Tradeline {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String

  creditorName      String
  originalCreditor  String?
  accountNumberMask String?
  accountType       AccountType @default(OTHER)
  isDebtBuyer       Boolean     @default(false)
  balance           Int         @default(0) // cents

  dateOpened             DateTime?
  dateReported           DateTime?
  dateOfFirstDelinquency DateTime?

  // Per-bureau presence + per-bureau values, stored as JSON keyed by bureau.
  // e.g. { "EQUIFAX": { "presence": "PRESENT", "status": "Open Collection", "balance": 101300 } }
  bureauData Json @default("{}")

  // Computed scoring
  score         Int         @default(0) // 0-100
  probability   Probability @default(LOW)
  reasons       String[]    @default([])
  disputeAngles String[]    @default([])

  // Duplicate grouping — tradelines representing the same underlying debt share a key
  duplicateGroup String?

  resolved   Boolean   @default(false)
  letters    Letter[]
  p0Accounts Account[]
  createdAt  DateTime  @default(now())

  // Additive composite key used only by P0 same-consumer provenance FKs.
  @@unique([userId, id], map: "Tradeline_userId_id_p0_key")
}

model Letter {
  id          String     @id @default(cuid())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  tradeline   Tradeline? @relation(fields: [tradelineId], references: [id], onDelete: SetNull)
  tradelineId String?

  strategy      String // e.g. "fcra_611", "validation"
  recipientType String // "bureau" | "furnisher" | "collector"
  recipientName String
  targetBureau  Bureau?
  round         Int     @default(1)

  body            String       @db.Text
  status          LetterStatus @default(GENERATED)
  complianceFlags String[]     @default([])

  // Bureau response + AI analysis (drives the Round 2 escalation flow).
  responseText     String?   @db.Text // pasted/extracted text of the bureau's response
  responseOutcome  String? // verified | deleted | updated | no_response | unknown
  responseAnalysis String?   @db.Text // AI summary of the response + escalation angle
  responseAt       DateTime?
  // Links a Round 2 (escalation) letter back to the round it follows up on.
  parentLetterId   String?

  createdAt DateTime  @default(now())
  mailedAt  DateTime?
}

// ---- Agency Community Hub ----------------------------------------------------
// A members-only discussion space for AGENCY subscribers (isAgency / agency tiers
// + the platform owner). Threads are authored by the agency ACCOUNT (never an
// impersonated client). authorId is nullable + SetNull so a deleted account leaves
// its posts intact (authorName is a denormalized snapshot for display). Kai —
// the platform's master AI expert — participates as replies with isKai = true and
// a null authorId.
model CommunityThread {
  id             String           @id @default(cuid())
  author         User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId       String?
  authorName     String // snapshot of the agency display name at post time
  category       String           @default("general") // general | wins | strategy | tools | questions
  title          String
  body           String           @db.Text
  pinned         Boolean          @default(false)
  locked         Boolean          @default(false)
  replyCount     Int              @default(0)
  lastActivityAt DateTime         @default(now())
  createdAt      DateTime         @default(now())
  replies        CommunityReply[]

  @@index([pinned, lastActivityAt])
  @@index([category])
}

model CommunityReply {
  id         String          @id @default(cuid())
  thread     CommunityThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId   String
  author     User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId   String?
  authorName String // snapshot; "Kai" for AI replies
  body       String          @db.Text
  isKai      Boolean         @default(false) // true = generated by the Kai master agent
  createdAt  DateTime        @default(now())

  @@index([threadId, createdAt])
}

// Member-submitted reports flagging a thread or reply for admin moderation review.
// Polymorphic + no FK to the target (`targetType` + `targetId`), so the report row
// survives after the offending content is removed (keeps the moderation trail).
// `threadId` is the owning thread for the admin's deep-link, even when the target
// is a reply. Self-heals at runtime like the other community tables (lib/community.ts).
model CommunityReport {
  id           String    @id @default(cuid())
  targetType   String // "thread" | "reply"
  targetId     String // CommunityThread.id or CommunityReply.id
  threadId     String // owning thread, for the admin deep-link
  reporterId   String? // reporting User.id (null if the user is later removed)
  reporterName String // snapshot of the reporter's display name
  reason       String?   @db.Text // optional free-text from the reporter
  status       String    @default("open") // open | actioned | dismissed
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// ---- Support tickets: available to EVERY signed-in user regardless of plan.
// A ticket is a thread of messages between the user and staff (isStaff replies).
model SupportTicket {
  id             String                 @id @default(cuid())
  user           User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId         String?
  userEmail      String // snapshot so staff can reply even if the user is removed
  userName       String // snapshot display name
  subject        String
  category       String                 @default("general") // general | billing | technical | account
  status         String                 @default("open") // open | responded | closed
  lastActivityAt DateTime               @default(now())
  createdAt      DateTime               @default(now())
  messages       SupportTicketMessage[]

  @@index([status, lastActivityAt])
  @@index([userId])
}

model SupportTicketMessage {
  id         String        @id @default(cuid())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId   String
  authorId   String?
  authorName String
  isStaff    Boolean       @default(false) // true = posted by support/admin
  body       String        @db.Text
  createdAt  DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// Encrypted file attachments for support messages and community posts. Same
// at-rest encryption as Document (AES-256-GCM, lib/docCrypto.ts, reusing
// DOCUMENT_ENCRYPTION_KEY); bytes are NEVER public — streamed back only through
// an ownership/membership-checked route (app/api/attachments/[id]). Polymorphic:
// `scope` says which kind of parent and `refId` is that parent's id
// (support_message | community_thread | community_reply). No FK so a parent in any
// of those tables can own one; rows are cleaned up with their parent in code.
model Attachment {
  id         String   @id @default(cuid())
  scope      String
  refId      String
  uploaderId String?
  filename   String
  mimeType   String
  byteSize   Int
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes
  createdAt  DateTime @default(now())

  @@index([scope, refId])
}

// ---- Rate limiting: DB-backed fixed-window counter ---------------------------
// Vercel serverless + Prisma Accelerate means in-memory counters don't survive
// across instances, so each (key, window) pair gets one row whose count is
// atomically incremented per request. `bucket` is `${key}:${windowStart}` where
// windowStart = floor(now/windowSec). Self-heals at runtime like the other tables
// (lib/rateLimit.ts), so no manual migrate is needed. Stale rows are harmless —
// they simply stop being touched once their window passes.
model RateHit {
  id          String   @id @default(cuid())
  bucket      String   @unique
  count       Int      @default(0)
  windowStart BigInt
  createdAt   DateTime @default(now())
}

// ---- Self-service password reset --------------------------------------------
// Single-use, expiring tokens for the forgot/reset flow. Only the sha256 HASH of
// the raw token is stored (the raw token lives only in the emailed link), so a DB
// read can never reset anyone's password. Self-heals at runtime like the other
// tables (lib/passwordReset.ts). No Prisma relation to User (kept standalone like
// RateHit); the FK is added in the self-heal DDL.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---- Web Push (PWA phone notifications) -------------------------------------
// One row per browser/device a user opted in from (a user can have several). Holds
// the W3C PushSubscription (endpoint + keys). Self-heals at runtime (lib/push.ts);
// dead endpoints (410/404 on send) are pruned automatically.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---- CreditVector Brief: curated consumer-credit news feed ---------------------
// AI drafts a summary; an admin must approve before it goes public (status flips to
// "published"). Self-heals at runtime (lib/brief.ts). `slug` powers the public SEO
// URL /brief/[slug]; `summary` is educational-framed markdown (never legal advice).
model BriefArticle {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  summary       String    @db.Text
  sourceUrl     String
  sourceName    String
  category      String    @default("consumer-rights")
  tags          String[]
  socialCaption String?
  videoUrl      String? // optional official YouTube link (embedded via the no-cookie player)
  status        String    @default("draft") // draft | published | rejected
  featured      Boolean   @default(false)
  views         Int       @default(0)
  likeCount     Int       @default(0) // denormalized count of 'like' reactions
  authorId      String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

// Per-user engagement on a Brief article. One row per (article, user, kind);
// kind = 'like' (public count) | 'bookmark' (private save). Likes also bump the
// denormalized BriefArticle.likeCount so the feed reads counts without an aggregate.
model BriefReaction {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  kind      String // 'like' | 'bookmark'
  createdAt DateTime @default(now())

  @@unique([articleId, userId, kind])
  @@index([userId, kind, createdAt])
  @@index([articleId, kind])
}

// Reader comment on a published Brief article (Phase 2b). Post-moderation:
// comments appear immediately (status 'visible') but are CROA-screened on write
// (prohibited-claim comments are rejected, not stored), reportable, and
// admin-removable (status 'removed', reversible). authorName is a privacy-safe
// handle snapshot (username or first name), never the full legal name.
model BriefComment {
  id         String   @id @default(cuid())
  articleId  String
  userId     String
  authorName String
  body       String   @db.Text
  status     String   @default("visible") // visible | removed
  flagged    Boolean  @default(false) // a reader reported it; awaits admin review
  createdAt  DateTime @default(now())

  @@index([articleId, status, createdAt])
  @@index([flagged, status])
}

// Dedup ledger for comment reports — one row per (comment, reporter) so a reader
// can't spam the moderation queue. Presence of any row flags the comment.
model BriefCommentReport {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
}

// BI-COST-01 — one row per AI call, written by lib/aiMeter.ts (self-heal table;
// costUsd is a list-price ESTIMATE — billing truth is the provider console).
model AiUsage {
  id               String   @id @default(cuid())
  surface          String
  model            String
  userId           String?
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costUsd          Float    @default(0)
  ok               Boolean  @default(true)
  ms               Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([surface, createdAt])
  @@index([userId, createdAt])
}

// Kai event stream (ADR-0007 E1) — append-only; producers in lib/kaiEvents.ts.
// Consumers (timeline, Kai Home, digests) render from this, never invent facts.
model KaiEvent {
  id         String   @id @default(cuid())
  userId     String
  type       String
  refType    String?
  refId      String?
  payload    Json?
  occurredAt DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([type, occurredAt])
}

// Kai Case Memory (Sprint VII): per-user last-seen marker for the "while you were
// away" catch-up. Self-heal table (ADR-0001), accessed via raw SQL in lib/kaiSeen.ts.
model KaiSeen {
  userId String   @id
  seenAt DateTime @default(now())
}

// ProductEvent (Private Alpha instrumentation, Beta Launch Strategy §5.2): a
// minimal first-party funnel/analytics sink, distinct from the user-facing
// KaiEvent stream. Self-heal table (ADR-0001), accessed via raw SQL in
// lib/events.ts. Meta is minimal and never contains PII.
model ProductEvent {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId])
}

// ── Operator Network — migration-first message layer (Sprint 7) ──────────────
// The FIRST migration-backed feature under the ratified migration-first policy.
// Reuses the frozen channel value-object registry (no Channel table), the CROA
// screening (screenCommunityText), the polymorphic Attachment/CommunityReport, and
// the canViewChannel/canPostChannel authz matrix. Tenant isolation is enforced at
// RUNTIME by authz AND, as row-level defense-in-depth, by audienceAgencyId on the
// row (stamped server-side from the channel's owner; null for members channels).
model NetworkMessage {
  id               String   @id @default(cuid())
  channelKey       String
  author           User?    @relation("NetworkMessages", fields: [authorId], references: [id], onDelete: SetNull)
  authorId         String?
  authorName       String
  body             String   @db.Text
  isKai            Boolean  @default(false)
  audienceAgencyId String? // row-level tenant backstop; null = members channel
  clientMsgId      String // client-supplied stable id => idempotent send
  createdAt        DateTime @default(now())

  @@unique([authorId, clientMsgId])
  @@index([channelKey, createdAt, id])
  @@index([audienceAgencyId])
}

model NetworkMessageReadState {
  id                String   @id @default(cuid())
  user              User     @relation("NetworkMessageReads", fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  channelKey        String
  lastReadAt        DateTime
  lastReadMessageId String?
  updatedAt         DateTime @updatedAt

  @@unique([userId, channelKey])
  @@index([userId])
}

// ── Platform Event Bus — immutable event log (Sprint 8) ──────────────────────
// The platform-wide realtime backbone's durable, REPLAYABLE, full-payload event
// log. Migration-first (NOT self-heal): created by a reviewed migration, never at
// runtime. Distinct from KernelEvent (hash-only, by privacy directive) and from
// KaiEvent (user-timeline). NO foreign key to User on purpose: events are an
// immutable coordination spine that must OUTLIVE the entities they mention (an
// ACCOUNT_DELETED event cannot cascade-delete with the account). `id` is
// deterministic + tenant-scoped (evt_<sha256(tenantId|source|dedupeKey)>), so it is
// the idempotency key — a retried publish is one ON CONFLICT(id) no-op. Ordering is
// the proven Sprint 7 [createdAt asc, id asc] total order (a cursor of
// createdAtMs:id), so no bespoke sequence is needed. payload is typed per contract
// and refs-only (no value-bearing PII). Tenant + agency isolation is enforced at the
// read layer via a SERVER-resolved AuthContext, backed by these indexes.
model EventEnvelope {
  id            String    @id
  type          String
  version       Int
  tenantId      String
  agencyId      String?
  actorId       String
  source        String
  correlationId String
  payload       Json
  redactedAt    DateTime? // data-subject erasure tombstone: payload cleared, envelope kept
  createdAt     DateTime  @default(now())

  @@index([tenantId, createdAt, id])
  @@index([tenantId, agencyId, createdAt, id])
  @@index([agencyId, createdAt, id]) // agency-stream read: index-seek the { agencyId } OR-branch
  @@index([type, createdAt, id])
  @@index([correlationId])
}

// ── Operator Identity — bounded context (Sprint 9) ───────────────────────────
// Migration-first (NOT self-heal). Consolidates the scattered identity concerns
// (OPERATOR-IDENTITY.md) into durable records WITHOUT duplicating the auth User:
//   • OperatorIdentity  — the platform identity of an account (1:1), with an
//     explicit lifecycle. `account` is the source of truth for auth/email/name;
//     this row adds a stable operatorId, an optional reserved handle, and state.
//   • Organization      — a durable org (agency) an account owns; `slug` unique.
//     Replaces reliance on the spoofable free-text agencyName for the org's id.
//   • OrganizationMembership — an operator's membership in an org with a role
//     (the RBAC extension beyond User.role). @@unique(org, operator) makes
//     membership idempotent and orphan-free.
// All three are dormant behind OPERATOR_IDENTITY_ENABLED (fail-closed) until the
// owner-gated migration + activation. Lifecycle transitions are governed by the
// pure state machines in lib/identity/state.ts; DEACTIVATED/REMOVED/ARCHIVED are
// terminal (no resurrection).

enum OperatorState {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

// Organization is a GENERIC platform entity; `kind` is the discriminator. AGENCY is
// one kind — Educators, Enterprises, marketplace Vendors, and internal Gabriel Capital
// Labs orgs are others. Kind-specific data lives in the owning vertical (keyed by
// organizationId), never on this row. Extensible: adding a kind is an additive
// `ALTER TYPE ADD VALUE`, never a redesign.
enum OrganizationKind {
  AGENCY
  ENTERPRISE
  EDUCATOR
  VENDOR
  INTERNAL
}

enum OrganizationState {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipState {
  ACTIVE
  SUSPENDED
  REMOVED
}

model OperatorIdentity {
  id          String        @id @default(cuid())
  account     User          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId   String        @unique // one operator identity per account, ever (idempotent register)
  handle      String?       @unique // reserved, default-private; nullable until claimed
  state       OperatorState @default(PENDING)
  stateReason String? // short lifecycle note (bounded); never PII
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  memberships OrganizationMembership[]

  // ---- Operator Reputation (Sprint 10): back-relations only.
  xpAwards   XpAward[]
  milestones ReputationMilestone[]

  @@index([state])
}

model Organization {
  id             String            @id @default(cuid())
  // Restrict, NOT Cascade: an Organization is a shared, multi-operator entity with its
  // own ARCHIVED terminal state. Cascading it off the owner's account deletion would
  // silently destroy the org AND cascade-wipe every other operator's membership. The
  // owner account must be explicitly archived / ownership-transferred first.
  owner          User              @relation("OrganizationOwner", fields: [ownerAccountId], references: [id], onDelete: Restrict)
  ownerAccountId String
  name           String
  slug           String            @unique // stable org id surface; never the spoofable agencyName
  kind           OrganizationKind  @default(AGENCY)
  state          OrganizationState @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  memberships OrganizationMembership[]

  @@index([ownerAccountId])
  @@index([state])
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  operator       OperatorIdentity @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  operatorId     String
  role           OrgRole          @default(MEMBER)
  state          MembershipState  @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, operatorId]) // idempotent + orphan-free membership
  @@index([operatorId])
  @@index([organizationId, state])
}

// ── Operator Reputation — durable Vector XP ledger (Sprint 10) ────────────────
// Migration-first (NOT self-heal). Implements VECTOR-XP.md §5: the APPEND-ONLY award
// ledger elevating the v1 reconcile-on-read Arena fold to durable truth. Rules:
//   • UNIQUE(subjectId, operatorId, awardKind) — the canonical idempotency triple.
//     subjectId = the STABLE business entity (outcomeAwardKey(letterId), a cert id…),
//     NEVER the per-emission event id (a naive sourceEventId key double-counts on
//     outcome flips — BLOCKER per the 2026-07-20 adversarial review). awardKind = the
//     earning DIMENSION ("outcome"…), not the class, so a deleted↔verified class flip
//     cannot mint twice for one letter (Arena rule 2, generalized). Reversals occupy
//     their own slot as awardKind "reverse:<kind>", referencing the original.
//   • Rows are NEVER updated or deleted (corrections = appended compensating records
//     with negative xp). The fold over the ledger re-derives truth; policy re-weights
//     are forward-only. Scoring policy/values come from lib/arena/policy.ts
//     (ARENA-CONTRIBUTION-POLICY owns policy; this service owns storage/progression).
//   • Milestones are LATCHED facts (UNIQUE(operatorId, milestoneKey)) immune to future
//     re-weighting; milestone DEFINITIONS are owner-gated (none built — DW-D8).
// Dormant behind OPERATOR_REPUTATION_ENABLED (fail-closed OFF).
model XpAward {
  id            String           @id @default(cuid())
  // Restrict, NOT Cascade: this is an APPEND-ONLY audit ledger. A cascade off the
  // operator (and transitively the account) would let a plain user-delete silently
  // destroy XP history + compensating records. Erasure must RETAIN pseudonymous,
  // PII-free award rows and shred only the identity join (VECTOR-XP §6.1) — an explicit
  // step, never a silent FK cascade.
  operator      OperatorIdentity @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  operatorId    String
  subjectId     String // stable, VERSION-FREE business entity the award is ABOUT (reputationSubjectId)
  awardKind     String // earning dimension ("outcome" | …); reversals: "reverse:<kind>"
  classId       String // ArenaClassId at issuance (data, deliberately NOT in the key)
  xp            Int // signed: reversal/compensating rows are negative
  policyVersion Int
  reversesId    String? // compensating record → the original award's id
  sourceEventId String? // provenance only (per-emission; NEVER part of the key)
  createdAt     DateTime         @default(now())

  @@unique([subjectId, operatorId, awardKind])
  @@index([operatorId, createdAt, id])
}

model ReputationMilestone {
  id            String           @id @default(cuid())
  // Restrict (see XpAward): a latched milestone is "earned once, ever" — a silent
  // cascade delete would un-latch it and re-registration would re-earn it.
  operator      OperatorIdentity @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  operatorId    String
  milestoneKey  String // bounded machine key; definitions are owner-gated policy
  xpAtAchieve   Int // the fold total when latched (stable evidence of achievement)
  policyVersion Int
  achievedAt    DateTime         @default(now())

  @@unique([operatorId, milestoneKey]) // latched: earned once, never re-earned/removed
  @@index([operatorId])
}

