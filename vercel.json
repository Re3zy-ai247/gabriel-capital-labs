{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "crons": [
    { "path": "/api/cron/brief-ingest", "schedule": "0 13 * * *" },
    { "path": "/api/cron/brief-digest", "schedule": "0 14 * * 1" }
  ]
}
