model ReportVersion {
  id                         String               @id @default(cuid())
  tenantId                   String
  consumerId                 String
  scope                      CreditTruthScope     @relation(fields: [tenantId, consumerId], references: [tenantId, consumerId], onDelete: Restrict, onUpdate: Restrict)
  sourceReportId             String?
  sourceReport               Report?              @relation(fields: [consumerId, sourceReportId], references: [userId, id], onDelete: Restrict, onUpdate: Restrict)
  reportSeriesKey            String
  version                    Int
  origin                     ReportVersionOrigin  @default(LEGACY_IMPORT)
  authorityStatus            TruthAuthorityStatus @default(LEGACY_UNVERIFIED)
  schemaVersion              String
  inputSha256                String               @db.VarChar(64)
  reportDateProvenance       ReportDateProvenance @default(UNKNOWN)
  reportDate                 DateTime?            @db.Date
  reportDateSourceLocator    String?
  reportDateRuleKey          String?
  reportDateRuleVersion      String?
  reanalysisAuthorizationRef String?
  createdByActorId           String
  createdAt                  DateTime             @default(now())

  extractionRuns          ExtractionRun[]
