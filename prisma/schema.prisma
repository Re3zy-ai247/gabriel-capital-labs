  attestedByActorId           String
  attestedAt                  DateTime
  supersedesAssertionId       String?
  supersedes                  IdentityCorrespondenceAssertion?      @relation("IdentityCorrespondenceAssertionSupersession", fields: [tenantId, consumerId, assertionSeriesKey, supersedesAssertionId], references: [tenantId, consumerId, assertionSeriesKey, id], onDelete: Restrict, onUpdate: Restrict, map: "identity_correspondence_assertion_supersession_fkey")
  supersededBy                IdentityCorrespondenceAssertion[]     @relation("IdentityCorrespondenceAssertionSupersession")
