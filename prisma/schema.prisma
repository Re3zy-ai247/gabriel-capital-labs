  reportAccounts          ReportVersionAccount[]
  identityBaselines       IdentityBaseline[]
  disputeCases            DisputeCase[]
  artifacts               Artifact[]                 @relation("ArtifactReportVersion")
  creditScoreObservations CreditScoreObservation[]
