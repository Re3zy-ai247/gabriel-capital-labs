  round0SourceCompleteness Round0SourceCompletenessEvidence[]
  identityBaselineAccountReviewMemberships IdentityBaselineAccountReviewMembership[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, reportSeriesKey, version])
  @@index([tenantId, consumerId, sourceReportId])
  @@index([tenantId, consumerId, authorityStatus, createdAt])
