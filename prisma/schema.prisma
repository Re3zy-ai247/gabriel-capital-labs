// The explicit ownership pair for the P0 bounded context. Scope creation must
// validate either tenantId == consumerId or the tenant's managed-client grant.
// Every child repeats both ids and joins through composite keys.
model CreditTruthScope {
  tenantId   String
  consumerId String
  tenant     User     @relation("CreditTruthTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  consumer   User     @relation("CreditTruthConsumer", fields: [consumerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt  DateTime @default(now())

  reportVersions          ReportVersion[]
  accounts                Account[]
  recipients              Recipient[]
  artifacts               Artifact[]
  evidenceEvents          EvidenceEvent[]
  creditScoreObservations CreditScoreObservation[]
  reportComparisons       ReportComparison[]
  reportDifferences       ReportDifference[]
  disputeOutcomes         DisputeOutcome[]
  reportIngestions        ReportIngestion[]
  sourceObjects           P0SourceObject[]
  sensitiveAccessEvents   P0SensitiveAccessEvent[]
  bureauReportDates       BureauReportDateEvidence[]
  consumerAccountReviews  ConsumerAccountReviewReceipt[]
  round0SourceCompleteness Round0SourceCompletenessEvidence[]
  identityBaselineAccountReviewMemberships IdentityBaselineAccountReviewMembership[]

  @@id([tenantId, consumerId])
  @@index([consumerId, tenantId])
}

// Sole durable Phase 2A ingestion queue. Source-object locator material is an
// encrypted recovery capability, not business evidence. Exact immutable truth is
// established only after the linked Artifact/ReportVersion/ExtractionRun are
// read back and semantically attested. Mutable fields advance by revisioned CAS.
model ReportIngestion {
  id                           String                  @id @default(cuid())
  tenantId                     String
  consumerId                   String
  scope                        CreditTruthScope        @relation(fields: [tenantId, consumerId], references: [tenantId, consumerId], onDelete: Restrict, onUpdate: Restrict)
  actorId                      String
  authorizationKind            P0AuthorizationKind
  authorizationVersion         String
  idempotencyKey               String
  operationKey                 String
  reportSeriesKey              String
  reservedVersion              Int
  sourceSha256                 String                  @db.VarChar(64)
  sourceByteLength             BigInt
  sourceDeclaredMimeType       String
  sourceDetectedMimeType       String
  sourceStorageProviderKey     String?
  sourceLocatorCiphertext      Bytes?
  sourceLocatorIv              Bytes?
  sourceLocatorAuthTag         Bytes?
  sourceLocatorKeyVersion      String?
  sourceLocatorAlgorithm       EncryptionAlgorithm?
  sourceLocatorEnvelopeVersion String?
  sourceLocatorAadVersion      String?
  sourceReadbackSha256         String?                 @db.VarChar(64)
  sourceReadbackByteLength     BigInt?
  sourceVerifiedAt             DateTime?
  sourceDisposition            ReportSourceDisposition @default(RETAINED)
  sourceDispositionReasonCode  String?
  sourceDispositionAt          DateTime?
  state                        ReportIngestionState    @default(RECEIVED)
  safeFailureCode              String?
  revision                     Int                     @default(1)
  attemptCount                 Int                     @default(0)
  maxAttempts                  Int                     @default(3)
  leaseToken                   String?
  leaseOwnerId                 String?
  leaseExpiresAt               DateTime?
  nextAttemptAt                DateTime?
  reportVersionId              String?
  reportVersion                ReportVersion?          @relation(fields: [tenantId, consumerId, reportVersionId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict, map: "report_ingestion_report_version_fkey")
  sourceArtifactId             String?
  sourceArtifact               Artifact?               @relation("ReportIngestionSourceArtifact", fields: [tenantId, consumerId, sourceArtifactId, sourceSha256], references: [tenantId, consumerId, id, sha256], onDelete: Restrict, onUpdate: Restrict, map: "report_ingestion_source_artifact_fkey")
  extractionRunId              String?
  extractionRun                ExtractionRun?          @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict, map: "report_ingestion_extraction_run_fkey")
  identityBaselines            IdentityBaseline[]      @relation("IdentityBaselineReportIngestion")
  sourceObjects                P0SourceObject[]
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  @@unique([tenantId, consumerId, id], map: "report_ingestion_scope_id_key")
  @@unique([tenantId, consumerId, idempotencyKey], map: "report_ingestion_idempotency_key")
  @@unique([tenantId, consumerId, operationKey], map: "report_ingestion_operation_key")
  @@unique([tenantId, consumerId, reportSeriesKey, reservedVersion], map: "report_ingestion_reservation_key")
  @@unique([tenantId, consumerId, reportVersionId, id], map: "report_ingestion_identity_baseline_pin_key")
  @@index([state, nextAttemptAt, leaseExpiresAt, createdAt], map: "report_ingestion_claim_idx")
  @@index([tenantId, consumerId, state, createdAt], map: "report_ingestion_scope_state_idx")
  @@index([tenantId, consumerId, sourceDisposition, createdAt], map: "report_ingestion_disposition_idx")
}

// Encrypted immutable source bytes used by the concrete trusted-writer path.
// Provider/object identities and both authenticated-encryption AAD digests are
// server-derived. No plaintext locator, report bytes, or consumer value is
// stored in this row.
model P0SourceObject {
  id                       String              @id
  tenantId                 String
  consumerId               String
  scope                    CreditTruthScope    @relation(fields: [tenantId, consumerId], references: [tenantId, consumerId], onDelete: Restrict, onUpdate: Restrict)
  ingestionId              String
  ingestion                ReportIngestion     @relation(fields: [tenantId, consumerId, ingestionId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict, map: "p0_source_object_ingestion_fkey")
  artifactId               String
  artifactVersion          Int
  providerOperationId      String
  providerObjectVersion    String
  kind                     String
  mimeType                 String
  sha256                   String              @db.VarChar(64)
  byteLength               BigInt
  ciphertext               Bytes
  iv                       Bytes
  authTag                  Bytes
  keyVersion               String
  algorithm                EncryptionAlgorithm
  envelopeVersion          String
  aadVersion               String
  aadSha256                String              @db.VarChar(64)
  locatorCiphertext        Bytes
  locatorIv                Bytes
  locatorAuthTag           Bytes
  locatorKeyVersion        String
  locatorAlgorithm         EncryptionAlgorithm
  locatorEnvelopeVersion   String
  locatorAadVersion        String
  locatorAadSha256         String              @db.VarChar(64)
  storedAt                 DateTime            @default(now())

  @@unique([tenantId, consumerId, id], map: "p0_source_object_scope_id_key")
  @@unique([tenantId, consumerId, artifactId, artifactVersion], map: "p0_source_object_artifact_version_key")
  @@unique([tenantId, consumerId, providerOperationId], map: "p0_source_object_provider_operation_key")
  @@unique([tenantId, consumerId, providerObjectVersion], map: "p0_source_object_provider_object_version_key")
  @@index([tenantId, consumerId, ingestionId], map: "p0_source_object_ingestion_idx")
}

// Immutable version header. The safe defaults deliberately classify an omitted
// origin/authority as legacy and unverified. Reanalysis is a separately authorized
