// Immutable receipt that the consumer authorized use of one exact classified
// identity fact for a bounded correspondence purpose. Classification remains on
// IdentityFact; this receipt cannot carry an alternate disposition.
model IdentityCorrespondenceAssertion {
  id                          String                                @id @default(cuid())
  tenantId                    String
  consumerId                  String
  reportVersionId             String
  extractionRunId             String
  identityBaselineId          String
  identityBaselineVersion     Int
  baselineInputSetSha256      String                                @db.VarChar(64)
