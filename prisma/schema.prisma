// A run is inserted as a completed immutable record; retries append a new attempt.
model ExtractionRun {
  id                   String              @id @default(cuid())
  tenantId             String
  consumerId           String
  reportVersionId      String
  reportVersion        ReportVersion       @relation(fields: [tenantId, consumerId, reportVersionId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict)
  runKey               String
  attempt              Int
  engine               ExtractionEngine
  engineVersion        String
  schemaVersion        String
  normalizationVersion String
  status               ExtractionRunStatus
  errorCodes           String[]            @default([])
  startedAt            DateTime
  completedAt          DateTime
  inputArtifactId      String?
  inputSha256          String?                        @db.VarChar(64)
  inputRepresentation  ExtractionInputRepresentation?
  inputArtifact        Artifact?                      @relation("ExtractionRunInputArtifact", fields: [tenantId, consumerId, inputArtifactId, inputSha256], references: [tenantId, consumerId, id, sha256], onDelete: Restrict, onUpdate: Restrict, map: "extraction_run_input_artifact_fkey")
  createdAt            DateTime            @default(now())

  observations            FieldObservation[]
  accountPresence         AccountPresenceObservation[]
  bureauCoverage          ExtractionBureauCoverage[]
  sectionCompleteness     SectionCompleteness[]
  historicalEvidence      HistoricalEvidence[]
  assessments             DerivedAccountAssessment[]
  creditScoreObservations CreditScoreObservation[]
  priorComparisons        ReportComparison[]           @relation("ReportComparisonPriorRun")
  currentComparisons      ReportComparison[]           @relation("ReportComparisonCurrentRun")
  reportIngestions        ReportIngestion[]
  bureauReportDates       BureauReportDateEvidence[]
  identityBaselines       IdentityBaseline[]             @relation("IdentityBaselineExtractionRun")
  identityFacts           IdentityFact[]                 @relation("IdentityFactExtractionRun")
  consumerAccountReviews  ConsumerAccountReviewReceipt[]
  round0SourceCompleteness Round0SourceCompletenessEvidence[]
  identityBaselineAccountReviewMemberships IdentityBaselineAccountReviewMembership[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, reportVersionId, id])
  @@unique([tenantId, consumerId, reportVersionId, runKey, attempt])
  @@index([tenantId, consumerId, reportVersionId, createdAt])
}

// Exact parser-v2 coveredBureaus snapshot for one immutable extraction. Exactly
// one row per supported bureau records either COVERED or OUTSIDE_COVERAGE.
model ExtractionBureauCoverage {
  id              String               @id @default(cuid())
  tenantId        String
  consumerId      String
  reportVersionId String
  extractionRunId String
  reportVersion   ReportVersion        @relation(fields: [tenantId, consumerId, reportVersionId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict, map: "extraction_bureau_coverage_report_fkey")
  extractionRun   ExtractionRun        @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict, map: "extraction_bureau_coverage_run_fkey")
  bureau          Bureau
  coverageStatus  BureauCoverageStatus
  createdAt       DateTime             @default(now())

  accountPresence         AccountPresenceObservation[]
  observations            FieldObservation[]
  sectionCompleteness     SectionCompleteness[]
  historicalEvidence      HistoricalEvidence[]
  creditScoreObservations CreditScoreObservation[]
  reportDates             BureauReportDateEvidence[]
  round0SourceCompleteness Round0SourceCompletenessEvidence[]
  priorDifferences        ReportDifference[]           @relation("ReportDifferencePriorCoverage")
  currentDifferences      ReportDifference[]           @relation("ReportDifferenceCurrentCoverage")

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, reportVersionId, extractionRunId, bureau])
  @@unique([tenantId, consumerId, reportVersionId, extractionRunId, bureau, id], map: "extraction_bureau_coverage_difference_pin_key")
  @@unique([tenantId, consumerId, reportVersionId, extractionRunId, bureau, coverageStatus, id], map: "extraction_bureau_coverage_pin_key")
  @@index([tenantId, consumerId, reportVersionId, extractionRunId, coverageStatus])
}

// Lossless bureau-specific report-date evidence for one exact parser-v2 run.
// The source value remains lexical so YEAR/MONTH precision is never promoted to
// an invented day. UNKNOWN is distinct from explicit source-reported absence.
model BureauReportDateEvidence {
  id                 String                     @id @default(cuid())
  tenantId           String
  consumerId         String
  scope              CreditTruthScope           @relation(fields: [tenantId, consumerId], references: [tenantId, consumerId], onDelete: Restrict, onUpdate: Restrict)
  reportVersionId    String
  reportVersion      ReportVersion              @relation(fields: [tenantId, consumerId, reportVersionId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict, map: "bureau_report_date_report_fkey")
  extractionRunId    String
  extractionRun      ExtractionRun              @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict, map: "bureau_report_date_run_fkey")
  bureau             Bureau
  coverageStatus     BureauCoverageStatus
  bureauCoverageId   String
  bureauCoverage     ExtractionBureauCoverage   @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, coverageStatus, bureauCoverageId], references: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, coverageStatus, id], onDelete: Restrict, onUpdate: Restrict, map: "bureau_report_date_coverage_fkey")
  presence           ReportDateEvidencePresence
  sourceValue        String?                    @db.VarChar(10)
  precision          ReportDatePrecision
  provenance         ReportDateProvenance
  sourceLocatorToken String?
  integritySha256    String                     @db.VarChar(64)
  createdAt          DateTime                   @default(now())

  @@unique([tenantId, consumerId, id], map: "bureau_report_date_scope_id_key")
  @@unique([tenantId, consumerId, reportVersionId, extractionRunId, bureau], map: "bureau_report_date_run_bureau_key")
  @@index([tenantId, consumerId, reportVersionId, bureau, presence], map: "bureau_report_date_report_idx")
}

// Immutable, value-free parser-v2 completeness evidence for every exact
// run/bureau/Round-0 catalog slot. UNRECOGNIZED_ACCOUNT is the ACCOUNT_INDEX
// slot; the other eight categories describe source-reported identity evidence.
// One exact run therefore carries 3 bureaus x 9 categories, including explicit
// OUTSIDE_COVERAGE rows. This is source evidence, never a consumer disposition.
model Round0SourceCompletenessEvidence {
  id                     String                   @id @default(cuid())
  tenantId               String
  consumerId             String
  scope                  CreditTruthScope         @relation(fields: [tenantId, consumerId], references: [tenantId, consumerId], onDelete: Restrict, onUpdate: Restrict)
  reportVersionId        String
  reportVersion          ReportVersion            @relation(fields: [tenantId, consumerId, reportVersionId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict, map: "round0_source_completeness_report_fkey")
  extractionRunId        String
  extractionRun          ExtractionRun            @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict, map: "round0_source_completeness_run_fkey")
  identityBaselineId     String?
  baselineInputSetSha256 String?                  @db.VarChar(64)
  identityBaseline       IdentityBaseline?        @relation("Round0SourceCompletenessBaseline", fields: [tenantId, consumerId, reportVersionId, extractionRunId, identityBaselineId, baselineInputSetSha256], references: [tenantId, consumerId, reportVersionId, extractionRunId, id, inputSetSha256], onDelete: Restrict, onUpdate: Restrict, map: "round0_source_completeness_baseline_fkey")
  bureau                 Bureau
  coverageStatus         BureauCoverageStatus
  bureauCoverageId       String
  bureauCoverage         ExtractionBureauCoverage @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, coverageStatus, bureauCoverageId], references: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, coverageStatus, id], onDelete: Restrict, onUpdate: Restrict, map: "round0_source_completeness_coverage_fkey")
  category               IdentityReviewCategory
  status                 SectionExtractionStatus
  sourceMemberCount      Int
  sourceMembershipSha256 String                   @db.VarChar(64)
  sourceLocatorToken     String?
  integritySha256        String                   @db.VarChar(64)
  ruleKey                String
  ruleVersion            String
  createdAt              DateTime                 @default(now())

  equifaxCategoryCompletions    IdentityCategoryCompletion[] @relation("IdentityCategoryCompletionEquifaxCompleteness")
  experianCategoryCompletions   IdentityCategoryCompletion[] @relation("IdentityCategoryCompletionExperianCompleteness")
  transunionCategoryCompletions IdentityCategoryCompletion[] @relation("IdentityCategoryCompletionTransunionCompleteness")
  consumerAccountReviews        ConsumerAccountReviewReceipt[]

  @@unique([tenantId, consumerId, id], map: "round0_source_completeness_scope_id_key")
  @@unique([tenantId, consumerId, id, sourceMembershipSha256, integritySha256], map: "round0_source_completeness_receipt_pin_key")
  @@unique([tenantId, consumerId, reportVersionId, extractionRunId, bureau, category], map: "round0_source_completeness_run_bureau_category_key")
  @@index([tenantId, consumerId, reportVersionId, extractionRunId, category, status], map: "round0_source_completeness_category_idx")
}

// Stable account identity within a consumer scope. stableKey is random/opaque,
// never a hash of an account number. Names, numbers and balances belong only in
// encrypted observations. A legacy link does not confer v2 authority.
model Account {
  id                String               @id @default(cuid())
  tenantId          String
  consumerId        String
  scope             CreditTruthScope     @relation(fields: [tenantId, consumerId], references: [tenantId, consumerId], onDelete: Restrict, onUpdate: Restrict)
  stableKey         String
  legacyTradelineId String?
  legacyTradeline   Tradeline?           @relation(fields: [consumerId, legacyTradelineId], references: [userId, id], onDelete: Restrict, onUpdate: Restrict)
  authorityStatus   TruthAuthorityStatus @default(LEGACY_UNVERIFIED)
  createdAt         DateTime             @default(now())

  reportVersions ReportVersionAccount[]
  consumerAccountReviews ConsumerAccountReviewReceipt[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, stableKey])
  @@index([tenantId, consumerId, legacyTradelineId])
}

// Immutable account subject in one ReportVersion. SOURCE_LISTED means the report
// actually listed the account and carries a source ordinal. COMPARISON_CARRY_FORWARD
// has no ordinal and exists only to evaluate a previously source-listed stable
// account against a later report's COMPLETE ACCOUNT_INDEX; it is not source truth.
model ReportVersionAccount {
  id                   String                        @id @default(cuid())
  tenantId             String
  consumerId           String
  reportVersionId      String
  accountId            String
  reportVersion        ReportVersion                 @relation(fields: [tenantId, consumerId, reportVersionId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict)
  account              Account                       @relation(fields: [tenantId, consumerId, accountId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict)
  sourceAccountOrdinal Int?
  membershipOrigin     ReportAccountMembershipOrigin
  authorityStatus      TruthAuthorityStatus          @default(LEGACY_UNVERIFIED)
  createdAt            DateTime                      @default(now())

  observations        FieldObservation[]
  accountPresence     AccountPresenceObservation[]
  sectionCompleteness SectionCompleteness[]
  historicalEvidence  HistoricalEvidence[]
  assessments         DerivedAccountAssessment[]
  consumerAccountReviews ConsumerAccountReviewReceipt[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, reportVersionId, accountId])
  @@unique([tenantId, consumerId, reportVersionId, id, accountId], map: "report_version_account_review_pin_key")
  @@unique([tenantId, consumerId, reportVersionId, sourceAccountOrdinal])
  @@index([tenantId, consumerId, accountId, reportVersionId])
}

// Typed, bureau-scoped parser-v2 accountPresence observation. Confirmed absence
// pins the exact COMPLETE ACCOUNT_INDEX row that supports that conclusion.
model AccountPresenceObservation {
  id                         String                   @id @default(cuid())
  tenantId                   String
  consumerId                 String
  reportVersionId            String
  accountId                  String
  extractionRunId            String
  reportAccount              ReportVersionAccount     @relation(fields: [tenantId, consumerId, reportVersionId, accountId], references: [tenantId, consumerId, reportVersionId, accountId], onDelete: Restrict, onUpdate: Restrict, map: "account_presence_account_fkey")
  extractionRun              ExtractionRun            @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict, map: "account_presence_run_fkey")
  bureau                     Bureau
  bureauCoverageId           String
  coverageStatus             BureauCoverageStatus
  bureauCoverage             ExtractionBureauCoverage @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, coverageStatus, bureauCoverageId], references: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, coverageStatus, id], onDelete: Restrict, onUpdate: Restrict, map: "account_presence_coverage_fkey")
  presence                   ObservationPresence
  observationSeriesKey       String
  revision                   Int                      @default(1)
  integritySha256            String                   @db.VarChar(64)
  sourceLocatorToken         String?
  parserConfidence           Decimal?                 @db.Decimal(5, 4)
  errorCodes                 String[]                 @default([])
  accountIndexReportSection  CreditReportSection      @default(ACCOUNT_INDEX)
  accountIndexStatus         SectionExtractionStatus?
  accountIndexCompletenessId String?
  accountIndexCompleteness   SectionCompleteness?     @relation(fields: [tenantId, consumerId, reportVersionId, accountId, extractionRunId, bureau, accountIndexReportSection, accountIndexStatus, accountIndexCompletenessId], references: [tenantId, consumerId, reportVersionId, accountId, extractionRunId, bureau, reportSection, status, id], onDelete: Restrict, onUpdate: Restrict, map: "account_presence_index_fkey")
  observedAt                 DateTime                 @default(now())

  priorDifferences   ReportDifference[] @relation("ReportDifferencePriorPresence")
  currentDifferences ReportDifference[] @relation("ReportDifferenceCurrentPresence")
  consumerAccountReviews ConsumerAccountReviewReceipt[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, observationSeriesKey, revision])
  @@unique([tenantId, consumerId, extractionRunId, accountId, bureau])
  @@unique([tenantId, consumerId, reportVersionId, extractionRunId, bureau, accountId, id], map: "account_presence_difference_pin_key")
  @@unique([tenantId, consumerId, reportVersionId, extractionRunId, bureau, accountId, id, revision, integritySha256], map: "account_presence_review_pin_key")
  @@index([tenantId, consumerId, reportVersionId, accountId, bureau, presence])
}

// One bureau/section/field/occurrence per row, pinned to its exact parser-v2
// SectionCompleteness record. PRESENT values may come from COMPLETE or PARTIAL
// sections; ABSENT_CONFIRMED requires COMPLETE; UNKNOWN retains the actual parser
// state. The locator is an opaque token plus numeric coordinates, never copied
// source text. integritySha256 covers the authenticated ciphertext envelope +
// machine metadata; it is never a hash of plaintext or a low-entropy consumer value.
model FieldObservation {
  id                        String                      @id @default(cuid())
  tenantId                  String
  consumerId                String
  reportVersionId           String
  accountId                 String
  extractionRunId           String
  reportAccount             ReportVersionAccount        @relation(fields: [tenantId, consumerId, reportVersionId, accountId], references: [tenantId, consumerId, reportVersionId, accountId], onDelete: Restrict, onUpdate: Restrict)
  extractionRun             ExtractionRun               @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict)
  bureauCoverageId          String
  coverageStatus            BureauCoverageStatus
  observationSeriesKey      String
  revision                  Int                         @default(1)
  integritySha256           String                      @db.VarChar(64)
  bureau                    Bureau
  bureauCoverage            ExtractionBureauCoverage    @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, coverageStatus, bureauCoverageId], references: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, coverageStatus, id], onDelete: Restrict, onUpdate: Restrict, map: "field_observation_coverage_fkey")
  reportSection             CreditReportSection
  sectionStatus             SectionExtractionStatus
  sectionCompletenessId     String
  sectionCompleteness       SectionCompleteness         @relation(fields: [tenantId, consumerId, reportVersionId, accountId, extractionRunId, bureau, reportSection, sectionStatus, sectionCompletenessId], references: [tenantId, consumerId, reportVersionId, accountId, extractionRunId, bureau, reportSection, status, id], onDelete: Restrict, onUpdate: Restrict, map: "field_observation_section_fkey")
  fieldKey                  String
  occurrence                Int                         @default(0)
  presence                  ObservationPresence
  valueType                 ObservationValueType
  valueCiphertext           Bytes?
  valueIv                   Bytes?
  valueAuthTag              Bytes?
  valueKeyVersion           String?
  valueAlgorithm            EncryptionAlgorithm?
  valueEnvelopeVersion      String?
  valueAadVersion           String?
  normalizedCiphertext      Bytes?
  normalizedIv              Bytes?
  normalizedAuthTag         Bytes?
  normalizedKeyVersion      String?
  normalizedAlgorithm       EncryptionAlgorithm?
  normalizedEnvelopeVersion String?
  normalizedAadVersion      String?
  assessmentSignal          ObservationAssessmentSignal @default(UNCLASSIFIED)
  sourceLocatorToken        String
  pageNumber                Int?
  sectionOrdinal            Int?
  recordOrdinal             Int?
  fieldOrdinal              Int?
  normalizationRuleKey      String
  normalizationRuleVersion  String
  parserConfidence          Decimal?                    @db.Decimal(5, 4)
  errorCodes                String[]                    @default([])
  observedAt                DateTime                    @default(now())

  assertions          ConsumerAssertion[]
  correspondenceItems CorrespondenceItem[]
  priorDifferences    ReportDifference[]   @relation("ReportDifferencePriorField")
  currentDifferences  ReportDifference[]   @relation("ReportDifferenceCurrentField")

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, reportVersionId, accountId, id])
  @@unique([tenantId, consumerId, reportVersionId, accountId, extractionRunId, bureau, fieldKey, observationSeriesKey, revision, integritySha256, id], map: "field_observation_assertion_pin_key")
  @@unique([tenantId, consumerId, observationSeriesKey, revision])
  @@unique([tenantId, consumerId, extractionRunId, accountId, bureau, reportSection, fieldKey, occurrence])
  @@unique([tenantId, consumerId, reportVersionId, extractionRunId, bureau, accountId, fieldKey, id], map: "field_observation_difference_pin_key")
  @@index([tenantId, consumerId, reportVersionId, accountId, bureau, reportSection])
  @@index([tenantId, consumerId, extractionRunId, presence])
}

// Explicit coverage record so a wholly missing section is UNKNOWN, never silently
// treated as absent or complete. Field-name arrays are bounded machine keys only.
model SectionCompleteness {
  id                       String                   @id @default(cuid())
  tenantId                 String
  consumerId               String
  reportVersionId          String
  accountId                String
  extractionRunId          String
  reportAccount            ReportVersionAccount     @relation(fields: [tenantId, consumerId, reportVersionId, accountId], references: [tenantId, consumerId, reportVersionId, accountId], onDelete: Restrict, onUpdate: Restrict, map: "section_completeness_account_fkey")
  extractionRun            ExtractionRun            @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict, map: "section_completeness_run_fkey")
  bureau                   Bureau
  bureauCoverageId         String
  coverageStatus           BureauCoverageStatus
  bureauCoverage           ExtractionBureauCoverage @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, coverageStatus, bureauCoverageId], references: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, coverageStatus, id], onDelete: Restrict, onUpdate: Restrict, map: "section_completeness_coverage_fkey")
  reportSection            CreditReportSection
  status                   SectionExtractionStatus
  requiredFieldKeys        String[]                 @default([])
  observedFieldKeys        String[]                 @default([])
  errorCodes               String[]                 @default([])
  normalizationRuleKey     String
  normalizationRuleVersion String
  createdAt                DateTime                 @default(now())

  accountPresenceObservations AccountPresenceObservation[]
  fieldObservations           FieldObservation[]
  historicalEvidence          HistoricalEvidence[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, extractionRunId, accountId, bureau, reportSection])
  @@unique([tenantId, consumerId, reportVersionId, accountId, extractionRunId, bureau, reportSection, status, id], map: "section_completeness_presence_pin_key")
  @@index([tenantId, consumerId, reportVersionId, accountId, bureau, status])
}

// Historical facts are first-class and cannot be erased by a later Closed/Paid/$0
// observation. Each fact pins the exact parser-v2 SectionCompleteness provenance;
// a confirmed absence is only authoritative from COMPLETE. Evidence details remain
// encrypted; evidenceType is a bounded domain fact used by the assessment engine.
model HistoricalEvidence {
  id                       String                   @id @default(cuid())
  tenantId                 String
  consumerId               String
  reportVersionId          String
  accountId                String
  extractionRunId          String
  reportAccount            ReportVersionAccount     @relation(fields: [tenantId, consumerId, reportVersionId, accountId], references: [tenantId, consumerId, reportVersionId, accountId], onDelete: Restrict, onUpdate: Restrict)
  extractionRun            ExtractionRun            @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict)
  bureau                   Bureau
  bureauCoverageId         String
  coverageStatus           BureauCoverageStatus
  bureauCoverage           ExtractionBureauCoverage @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, coverageStatus, bureauCoverageId], references: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, coverageStatus, id], onDelete: Restrict, onUpdate: Restrict, map: "historical_evidence_coverage_fkey")
  reportSection            CreditReportSection
  sectionStatus            SectionExtractionStatus
  sectionCompletenessId    String
  sectionCompleteness      SectionCompleteness      @relation(fields: [tenantId, consumerId, reportVersionId, accountId, extractionRunId, bureau, reportSection, sectionStatus, sectionCompletenessId], references: [tenantId, consumerId, reportVersionId, accountId, extractionRunId, bureau, reportSection, status, id], onDelete: Restrict, onUpdate: Restrict, map: "historical_evidence_section_fkey")
  evidenceType             HistoricalEvidenceType
  occurrence               Int                      @default(0)
  presence                 ObservationPresence
  detailCiphertext         Bytes?
  detailIv                 Bytes?
  detailAuthTag            Bytes?
  detailKeyVersion         String?
  detailAlgorithm          EncryptionAlgorithm?
  detailEnvelopeVersion    String?
  detailAadVersion         String?
  sourceLocatorToken       String
  normalizationRuleKey     String
  normalizationRuleVersion String
  parserConfidence         Decimal?                 @db.Decimal(5, 4)
  observedAt               DateTime                 @default(now())

  correspondenceItems CorrespondenceItem[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, reportVersionId, accountId, id])
  @@unique([tenantId, consumerId, reportVersionId, accountId, extractionRunId, bureau, id], map: "historical_evidence_chain_key")
  @@unique([tenantId, consumerId, extractionRunId, accountId, bureau, reportSection, evidenceType, occurrence])
  @@index([tenantId, consumerId, reportVersionId, accountId, bureau, evidenceType])
}

// Immutable assessment version over one exact extraction run and input digest.
model DerivedAccountAssessment {
  id                   String                         @id @default(cuid())
  tenantId             String
  consumerId           String
  reportVersionId      String
  accountId            String
  extractionRunId      String
  reportAccount        ReportVersionAccount           @relation(fields: [tenantId, consumerId, reportVersionId, accountId], references: [tenantId, consumerId, reportVersionId, accountId], onDelete: Restrict, onUpdate: Restrict, map: "daa_report_account_fkey")
  extractionRun        ExtractionRun                  @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict, map: "daa_extraction_run_fkey")
  assessmentVersion    Int
  classifierVersion    String
  policyVersion        String
  inputSetSha256       String                         @db.VarChar(64)
  evidenceCompleteness AssessmentEvidenceCompleteness
  accountCondition     AccountCondition
  disputeGrounds       DisputeGrounds
  reportedAdversity    ReportedAdversity
  rationaleCodes       String[]                       @default([])
  createdAt            DateTime                       @default(now())

  assertions          ConsumerAssertion[]
  correspondenceItems CorrespondenceItem[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, reportVersionId, accountId, id], map: "daa_scope_report_account_id_key")
  @@unique([tenantId, consumerId, reportVersionId, accountId, extractionRunId, id], map: "daa_assertion_chain_key")
  @@unique([tenantId, consumerId, reportVersionId, accountId, assessmentVersion], map: "daa_scope_account_version_key")
  @@index([tenantId, consumerId, reportVersionId, accountCondition, reportedAdversity])
}

// Consumer confirmation is bound to one exact immutable observation AND one exact
// assessment version. A later report/observation cannot reuse it; reconfirmation
// appends a new series version. Free text is encrypted, never indexed.
model ConsumerAssertion {
  id                         String                       @id @default(cuid())
  operationId                String
  tenantId                   String
  consumerId                 String
  reportVersionId            String
  accountId                  String
  extractionRunId            String
  bureau                     Bureau
  fieldKey                   String
  observationId              String
  observationSeriesKey       String
  observationRevision        Int
  observationIntegritySha256 String                       @db.VarChar(64)
  integritySha256            String?                      @db.VarChar(64)
  assessmentId               String
  observation                FieldObservation             @relation(fields: [tenantId, consumerId, reportVersionId, accountId, extractionRunId, bureau, fieldKey, observationSeriesKey, observationRevision, observationIntegritySha256, observationId], references: [tenantId, consumerId, reportVersionId, accountId, extractionRunId, bureau, fieldKey, observationSeriesKey, revision, integritySha256, id], onDelete: Restrict, onUpdate: Restrict, map: "consumer_assertion_observation_fkey")
  assessment                 DerivedAccountAssessment     @relation(fields: [tenantId, consumerId, reportVersionId, accountId, extractionRunId, assessmentId], references: [tenantId, consumerId, reportVersionId, accountId, extractionRunId, id], onDelete: Restrict, onUpdate: Restrict, map: "consumer_assertion_assessment_fkey")
  assertionSeriesKey         String
  version                    Int
  disposition                ConsumerAssertionDisposition
  statementCiphertext        Bytes?
  statementIv                Bytes?
  statementAuthTag           Bytes?
  statementKeyVersion        String?
  statementAlgorithm         EncryptionAlgorithm?
  statementEnvelopeVersion   String?
  statementAadVersion        String?
  confirmedByActorId         String
  confirmedAt                DateTime
  expiresAt                  DateTime?
  supersedesAssertionId      String?
  supersedes                 ConsumerAssertion?           @relation("ConsumerAssertionSupersession", fields: [tenantId, consumerId, assertionSeriesKey, supersedesAssertionId], references: [tenantId, consumerId, assertionSeriesKey, id], onDelete: Restrict, onUpdate: Restrict, map: "consumer_assertion_supersession_fkey")
  supersededBy               ConsumerAssertion[]          @relation("ConsumerAssertionSupersession")
  createdAt                  DateTime                     @default(now())

  correspondenceItems CorrespondenceItem[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, operationId], map: "consumer_assertion_operation_key")
  @@unique([tenantId, consumerId, reportVersionId, accountId, id])
  @@unique([tenantId, consumerId, reportVersionId, accountId, extractionRunId, bureau, fieldKey, observationSeriesKey, observationRevision, observationIntegritySha256, observationId, assessmentId, id], map: "consumer_assertion_chain_key")
  @@unique([tenantId, consumerId, assertionSeriesKey, id], map: "consumer_assertion_supersession_key")
  @@unique([tenantId, consumerId, assertionSeriesKey, version])
  @@unique([tenantId, consumerId, reportVersionId, extractionRunId, bureau, accountId, fieldKey, id], map: "consumer_assertion_difference_pin_key")
  @@index([tenantId, consumerId, observationId, confirmedAt])
  @@index([tenantId, consumerId, assessmentId])
}

// Immutable bureau score evidence. occurrence is the score slot within one exact
// report/run/bureau; revisions append corrections inside that same source context.
// A later report or extraction run starts a new observation series at revision 1.
// Report-derived rows are primary and pin one exact extraction coverage row.
// Manually entered scores are explicitly secondary, unverified context and cannot
// be used as authoritative comparison inputs. The consumer score itself is
// ciphertext only; model/scale/source fields are bounded non-PII metadata.
// SCORE_NOT_PROVIDED never stores an invented numeric value.
model CreditScoreObservation {
  id                        String                          @id @default(cuid())
  tenantId                  String
  consumerId                String
  scope                     CreditTruthScope                @relation(fields: [tenantId, consumerId], references: [tenantId, consumerId], onDelete: Restrict, onUpdate: Restrict)
  reportVersionId           String?
  reportVersion             ReportVersion?                  @relation(fields: [tenantId, consumerId, reportVersionId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict, map: "credit_score_report_fkey")
  extractionRunId           String?
  extractionRun             ExtractionRun?                  @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict, map: "credit_score_run_fkey")
  bureau                    Bureau
  coverageStatus            BureauCoverageStatus?
  bureauCoverageId          String?
  bureauCoverage            ExtractionBureauCoverage?       @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, coverageStatus, bureauCoverageId], references: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, coverageStatus, id], onDelete: Restrict, onUpdate: Restrict, map: "credit_score_coverage_fkey")
  sourceType                CreditScoreSourceType
  evidenceRole              CreditScoreEvidenceRole
  presence                  CreditScorePresence
  evidenceCompleteness      CreditScoreEvidenceCompleteness
  observationSeriesKey      String
  revision                  Int                             @default(1)
  occurrence                Int                             @default(0)
  idempotencyKey            String
  integritySha256           String                          @db.VarChar(64)
  scoreCiphertext           Bytes?
  scoreIv                   Bytes?
  scoreAuthTag              Bytes?
  scoreKeyVersion           String?
  scoreAlgorithm            EncryptionAlgorithm?
  scoreEnvelopeVersion      String?
  scoreAadVersion           String?
  scoreModelKey             String?
  scoreModelVersion         String?
  scoreModelPresence           CreditScoreModelPresence?
  scoreModelEvidenceValue      String?
  scoreModelSourceLocatorToken String?
  scoreScaleMin             Int?
  scoreScaleMax             Int?
  modelMetadataCompleteness ScoreModelMetadataCompleteness
  sourceMethodKey           String
  sourceMethodVersion       String
  sourceLocatorToken        String?
  pageNumber                Int?
  sectionOrdinal            Int?
  normalizationRuleKey      String?
  normalizationRuleVersion  String?
  parserConfidence          Decimal?                        @db.Decimal(5, 4)
  errorCodes                String[]                        @default([])
  enteredByActorId          String?
  enteredAt                 DateTime?
  supersedesObservationId   String?
  supersedes                CreditScoreObservation?         @relation("CreditScoreSupersession", fields: [tenantId, consumerId, observationSeriesKey, supersedesObservationId], references: [tenantId, consumerId, observationSeriesKey, id], onDelete: Restrict, onUpdate: Restrict, map: "credit_score_supersession_fkey")
  supersededBy              CreditScoreObservation[]        @relation("CreditScoreSupersession")
  observedAt                DateTime
  createdAt                 DateTime                        @default(now())

  priorDifferences   ReportDifference[] @relation("ReportDifferencePriorScore")
  currentDifferences ReportDifference[] @relation("ReportDifferenceCurrentScore")

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, observationSeriesKey, id], map: "credit_score_supersession_key")
  @@unique([tenantId, consumerId, observationSeriesKey, revision])
  @@unique([tenantId, consumerId, idempotencyKey])
  @@unique([tenantId, consumerId, reportVersionId, extractionRunId, bureau, sourceMethodKey, sourceMethodVersion, occurrence, id], map: "credit_score_difference_pin_key")
  @@unique([tenantId, consumerId, reportVersionId, extractionRunId, bureau, sourceType, sourceMethodKey, sourceMethodVersion, occurrence, revision], map: "credit_score_run_bureau_occurrence_revision_key")
  @@index([tenantId, consumerId, reportVersionId, bureau, sourceType, presence])
}

// Immutable comparison decision over two exact report/extraction snapshots.
// The source digest identifies the selected immutable observations; it is never a
// digest of plaintext consumer values. Recalculation appends a series version.
model ReportComparison {
  id                     String                         @id @default(cuid())
  tenantId               String
  consumerId             String
  scope                  CreditTruthScope               @relation(fields: [tenantId, consumerId], references: [tenantId, consumerId], onDelete: Restrict, onUpdate: Restrict)
  priorReportVersionId   String
  priorReportVersion     ReportVersion                  @relation("ReportComparisonPriorReport", fields: [tenantId, consumerId, priorReportVersionId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict, map: "report_comparison_prior_report_fkey")
  priorExtractionRunId   String
  priorExtractionRun     ExtractionRun                  @relation("ReportComparisonPriorRun", fields: [tenantId, consumerId, priorReportVersionId, priorExtractionRunId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict, map: "report_comparison_prior_run_fkey")
  currentReportVersionId String
  currentReportVersion   ReportVersion                  @relation("ReportComparisonCurrentReport", fields: [tenantId, consumerId, currentReportVersionId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict, map: "report_comparison_current_report_fkey")
  currentExtractionRunId String
  currentExtractionRun   ExtractionRun                  @relation("ReportComparisonCurrentRun", fields: [tenantId, consumerId, currentReportVersionId, currentExtractionRunId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict, map: "report_comparison_current_run_fkey")
  comparisonSeriesKey    String
  version                Int
  idempotencyKey         String
  state                  ReportComparisonState
  evidenceCompleteness   ComparisonEvidenceCompleteness
  sourcePolicy           ComparisonSourcePolicy         @default(REPORT_DERIVED_ONLY)
  purpose                ReportComparisonPurpose
  chronologyBasis        ComparisonChronologyBasis
  chronologyRuleKey      String
  chronologyRuleVersion  String
  comparisonModelKey     String
  comparisonModelVersion String
  sourceSetSha256        String                         @db.VarChar(64)
  integritySha256        String                         @db.VarChar(64)
  differenceCount        Int
  reasonCodes            String[]                       @default([])
  supersedesComparisonId String?
  supersedes             ReportComparison?              @relation("ReportComparisonSupersession", fields: [tenantId, consumerId, comparisonSeriesKey, supersedesComparisonId], references: [tenantId, consumerId, comparisonSeriesKey, id], onDelete: Restrict, onUpdate: Restrict, map: "report_comparison_supersession_fkey")
  supersededBy           ReportComparison[]             @relation("ReportComparisonSupersession")
  createdByActorId       String
  createdAt              DateTime                       @default(now())

  differences     ReportDifference[]
  disputeOutcomes DisputeOutcome[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, comparisonSeriesKey, id], map: "report_comparison_supersession_key")
  @@unique([tenantId, consumerId, comparisonSeriesKey, version])
  @@unique([tenantId, consumerId, idempotencyKey])
  @@unique([tenantId, consumerId, priorReportVersionId, priorExtractionRunId, currentReportVersionId, currentExtractionRunId, id], map: "report_comparison_difference_pin_key")
  @@index([tenantId, consumerId, currentReportVersionId, state, createdAt])
}

// A versioned, source-row-pinned difference. Comparable states require both exact
// source observations. Confirmed current-report absence is limited to a COMPLETE current
// ACCOUNT_INDEX observation that explicitly says ABSENT_CONFIRMED; a missing row
// or incomplete extraction can only produce UNKNOWN_INCOMPLETE/NOT_COMPARABLE.
model ReportDifference {
  id                              String                         @id @default(cuid())
  tenantId                        String
  consumerId                      String
  scope                           CreditTruthScope               @relation(fields: [tenantId, consumerId], references: [tenantId, consumerId], onDelete: Restrict, onUpdate: Restrict)
  priorReportVersionId            String
  priorExtractionRunId            String
  currentReportVersionId          String
  currentExtractionRunId          String
  comparisonId                    String
  comparison                      ReportComparison               @relation(fields: [tenantId, consumerId, priorReportVersionId, priorExtractionRunId, currentReportVersionId, currentExtractionRunId, comparisonId], references: [tenantId, consumerId, priorReportVersionId, priorExtractionRunId, currentReportVersionId, currentExtractionRunId, id], onDelete: Restrict, onUpdate: Restrict, map: "report_difference_comparison_fkey")
  scopeType                       ReportDifferenceScope
  bureau                          Bureau?
  accountId                       String?
  fieldKey                        String?
  scoreOccurrence                 Int?
  priorScoreSourceMethodKey       String?
  priorScoreSourceMethodVersion   String?
  currentScoreSourceMethodKey     String?
  currentScoreSourceMethodVersion String?
  priorPresenceObservationId      String?
  priorPresenceObservation        AccountPresenceObservation?    @relation("ReportDifferencePriorPresence", fields: [tenantId, consumerId, priorReportVersionId, priorExtractionRunId, bureau, accountId, priorPresenceObservationId], references: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, accountId, id], onDelete: Restrict, onUpdate: Restrict, map: "report_difference_prior_presence_fkey")
  currentPresenceObservationId    String?
  currentPresenceObservation      AccountPresenceObservation?    @relation("ReportDifferenceCurrentPresence", fields: [tenantId, consumerId, currentReportVersionId, currentExtractionRunId, bureau, accountId, currentPresenceObservationId], references: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, accountId, id], onDelete: Restrict, onUpdate: Restrict, map: "report_difference_current_presence_fkey")
  priorFieldObservationId         String?
  priorFieldObservation           FieldObservation?              @relation("ReportDifferencePriorField", fields: [tenantId, consumerId, priorReportVersionId, priorExtractionRunId, bureau, accountId, fieldKey, priorFieldObservationId], references: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, accountId, fieldKey, id], onDelete: Restrict, onUpdate: Restrict, map: "report_difference_prior_field_fkey")
  currentFieldObservationId       String?
  currentFieldObservation         FieldObservation?              @relation("ReportDifferenceCurrentField", fields: [tenantId, consumerId, currentReportVersionId, currentExtractionRunId, bureau, accountId, fieldKey, currentFieldObservationId], references: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, accountId, fieldKey, id], onDelete: Restrict, onUpdate: Restrict, map: "report_difference_current_field_fkey")
  priorScoreObservationId         String?
  priorScoreObservation           CreditScoreObservation?        @relation("ReportDifferencePriorScore", fields: [tenantId, consumerId, priorReportVersionId, priorExtractionRunId, bureau, priorScoreSourceMethodKey, priorScoreSourceMethodVersion, scoreOccurrence, priorScoreObservationId], references: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, sourceMethodKey, sourceMethodVersion, occurrence, id], onDelete: Restrict, onUpdate: Restrict, map: "report_difference_prior_score_fkey")
  currentScoreObservationId       String?
  currentScoreObservation         CreditScoreObservation?        @relation("ReportDifferenceCurrentScore", fields: [tenantId, consumerId, currentReportVersionId, currentExtractionRunId, bureau, currentScoreSourceMethodKey, currentScoreSourceMethodVersion, scoreOccurrence, currentScoreObservationId], references: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, sourceMethodKey, sourceMethodVersion, occurrence, id], onDelete: Restrict, onUpdate: Restrict, map: "report_difference_current_score_fkey")
  priorCoverageObservationId      String?
  priorCoverageObservation        ExtractionBureauCoverage?      @relation("ReportDifferencePriorCoverage", fields: [tenantId, consumerId, priorReportVersionId, priorExtractionRunId, bureau, priorCoverageObservationId], references: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, id], onDelete: Restrict, onUpdate: Restrict, map: "report_difference_prior_coverage_fkey")
  currentCoverageObservationId    String?
  currentCoverageObservation      ExtractionBureauCoverage?      @relation("ReportDifferenceCurrentCoverage", fields: [tenantId, consumerId, currentReportVersionId, currentExtractionRunId, bureau, currentCoverageObservationId], references: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, id], onDelete: Restrict, onUpdate: Restrict, map: "report_difference_current_coverage_fkey")
  identityFactSeriesKey           String?
  priorIdentityBaselineId         String?
  priorIdentityFactId             String?
  priorIdentityFact               IdentityFact?                  @relation("ReportDifferencePriorIdentityFact", fields: [tenantId, consumerId, priorReportVersionId, priorIdentityBaselineId, identityFactSeriesKey, priorIdentityFactId], references: [tenantId, consumerId, reportVersionId, identityBaselineId, factSeriesKey, id], onDelete: Restrict, onUpdate: Restrict, map: "report_difference_prior_identity_fact_fkey")
  currentIdentityBaselineId       String?
  currentIdentityFactId           String?
  currentIdentityFact             IdentityFact?                  @relation("ReportDifferenceCurrentIdentityFact", fields: [tenantId, consumerId, currentReportVersionId, currentIdentityBaselineId, identityFactSeriesKey, currentIdentityFactId], references: [tenantId, consumerId, reportVersionId, identityBaselineId, factSeriesKey, id], onDelete: Restrict, onUpdate: Restrict, map: "report_difference_current_identity_fact_fkey")
  priorCompleteness               ComparisonEvidenceCompleteness
  currentCompleteness             ComparisonEvidenceCompleteness
  comparability                   DifferenceComparability
  differenceState                 ReportDifferenceState
  changeKind                      ReportDifferenceChangeKind
  deletionState                   DeletionInferenceState         @default(NOT_APPLICABLE)
  differenceSeriesKey             String
  version                         Int
  idempotencyKey                  String
  comparisonRuleKey               String
  comparisonRuleVersion           String
  sourceSetSha256                 String                         @db.VarChar(64)
  integritySha256                 String                         @db.VarChar(64)
  reasonCodes                     String[]                       @default([])
  supersedesDifferenceId          String?
  supersedes                      ReportDifference?              @relation("ReportDifferenceSupersession", fields: [tenantId, consumerId, differenceSeriesKey, supersedesDifferenceId], references: [tenantId, consumerId, differenceSeriesKey, id], onDelete: Restrict, onUpdate: Restrict, map: "report_difference_supersession_fkey")
  supersededBy                    ReportDifference[]             @relation("ReportDifferenceSupersession")
  createdByActorId                String
  createdAt                       DateTime                       @default(now())

  disputeOutcomes DisputeOutcome[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, comparisonId, id])
  @@unique([tenantId, consumerId, priorReportVersionId, currentReportVersionId, comparisonId, id], map: "report_difference_outcome_pin_key")
  @@unique([tenantId, consumerId, differenceSeriesKey, id], map: "report_difference_supersession_key")
  @@unique([tenantId, consumerId, differenceSeriesKey, version])
  @@unique([tenantId, consumerId, comparisonId, differenceSeriesKey], map: "report_difference_comparison_series_key")
  @@unique([tenantId, consumerId, idempotencyKey])
  @@index([tenantId, consumerId, comparisonId, scopeType, bureau, priorScoreSourceMethodKey, priorScoreSourceMethodVersion, currentScoreSourceMethodKey, currentScoreSourceMethodVersion, scoreOccurrence, differenceState])
}

// Immutable fact decision over one exact comparison difference and originating
// dispute case. States describe observed report evidence only; the closed causality
// enum cannot claim that a dispute caused a change or deletion. Pending rows have
// no decision source; system-derived report facts and human-confirmed judgment
// states are structurally separated by migration-owned checks/triggers.
model DisputeOutcome {
  id                            String                         @id @default(cuid())
  tenantId                      String
  consumerId                    String
  scope                         CreditTruthScope               @relation(fields: [tenantId, consumerId], references: [tenantId, consumerId], onDelete: Restrict, onUpdate: Restrict)
  priorReportVersionId          String
  priorExtractionRunId          String
  currentReportVersionId        String
  currentExtractionRunId        String
  caseId                        String
  disputeCase                   DisputeCase                    @relation(fields: [tenantId, consumerId, priorReportVersionId, caseId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict)
  comparisonId                  String
  comparison                    ReportComparison               @relation(fields: [tenantId, consumerId, priorReportVersionId, priorExtractionRunId, currentReportVersionId, currentExtractionRunId, comparisonId], references: [tenantId, consumerId, priorReportVersionId, priorExtractionRunId, currentReportVersionId, currentExtractionRunId, id], onDelete: Restrict, onUpdate: Restrict, map: "dispute_outcome_comparison_fkey")
  differenceId                  String
  difference                    ReportDifference               @relation(fields: [tenantId, consumerId, priorReportVersionId, currentReportVersionId, comparisonId, differenceId], references: [tenantId, consumerId, priorReportVersionId, currentReportVersionId, comparisonId, id], onDelete: Restrict, onUpdate: Restrict, map: "dispute_outcome_difference_fkey")
  bureau                        Bureau
  accountId                     String
  targetFieldKey                String
  targetConsumerAssertionId     String
  targetCorrespondenceId        String
  targetCorrespondenceItemId    String
  targetCorrespondenceItem      CorrespondenceItem             @relation(fields: [tenantId, consumerId, priorReportVersionId, caseId, targetCorrespondenceId, accountId, bureau, targetFieldKey, targetConsumerAssertionId, targetCorrespondenceItemId], references: [tenantId, consumerId, reportVersionId, caseId, correspondenceId, accountId, bureau, fieldKey, consumerAssertionId, id], onDelete: Restrict, onUpdate: Restrict, map: "dispute_outcome_target_item_fkey")
  targetCorrespondenceVersionId String
  targetVersionMembershipId     String
  targetVersionMembership       CorrespondenceVersionItem      @relation(fields: [tenantId, consumerId, priorReportVersionId, caseId, targetCorrespondenceId, targetCorrespondenceVersionId, targetCorrespondenceItemId, targetVersionMembershipId], references: [tenantId, consumerId, reportVersionId, caseId, correspondenceId, correspondenceVersionId, correspondenceItemId, id], onDelete: Restrict, onUpdate: Restrict, map: "dispute_outcome_target_membership_fkey")
  priorCompleteness             ComparisonEvidenceCompleteness
  currentCompleteness           ComparisonEvidenceCompleteness
  outcomeState                  DisputeOutcomeState
  causalityState                OutcomeCausalityState          @default(NO_CAUSAL_CLAIM)
  decisionSource                OutcomeDecisionSource?
  outcomeSeriesKey              String
  version                       Int
  idempotencyKey                String
  decisionModelKey              String
  decisionModelVersion          String
  sourceSetSha256               String                         @db.VarChar(64)
  integritySha256               String                         @db.VarChar(64)
  reasonCodes                   String[]                       @default([])
  decidedByActorId              String?
  decidedAt                     DateTime?
  supersedesOutcomeId           String?
  supersedes                    DisputeOutcome?                @relation("DisputeOutcomeSupersession", fields: [tenantId, consumerId, outcomeSeriesKey, supersedesOutcomeId], references: [tenantId, consumerId, outcomeSeriesKey, id], onDelete: Restrict, onUpdate: Restrict, map: "dispute_outcome_supersession_fkey")
  supersededBy                  DisputeOutcome[]               @relation("DisputeOutcomeSupersession")
  createdAt                     DateTime                       @default(now())

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, outcomeSeriesKey, id], map: "dispute_outcome_supersession_key")
  @@unique([tenantId, consumerId, outcomeSeriesKey, version])
  @@unique([tenantId, consumerId, idempotencyKey])
  @@index([tenantId, consumerId, caseId, outcomeState, createdAt])
  @@index([tenantId, consumerId, comparisonId, differenceId])
}

// Versioned Round-0 identity baseline. CONFIRMED is a new immutable row/version,
// not an in-place rewrite of a draft.
model IdentityBaseline {
  id                 String                 @id @default(cuid())
  tenantId           String
  consumerId         String
  reportVersionId    String
  reportVersion      ReportVersion          @relation(fields: [tenantId, consumerId, reportVersionId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict)
  extractionRunId    String?
  extractionRun      ExtractionRun?         @relation("IdentityBaselineExtractionRun", fields: [tenantId, consumerId, reportVersionId, extractionRunId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict, map: "identity_baseline_extraction_run_fkey")
  reportIngestionId  String?
  reportIngestion    ReportIngestion?        @relation("IdentityBaselineReportIngestion", fields: [tenantId, consumerId, reportVersionId, reportIngestionId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict, map: "identity_baseline_report_ingestion_fkey")
  sourceIdentityBaselineId            String?
  sourceIdentityBaseline              IdentityBaseline?  @relation("IdentityBaselineConfirmationSource", fields: [tenantId, consumerId, reportVersionId, extractionRunId, sourceIdentityBaselineId, inputSetSha256], references: [tenantId, consumerId, reportVersionId, extractionRunId, id, inputSetSha256], onDelete: Restrict, onUpdate: Restrict, map: "identity_baseline_confirmation_source_fkey")
  confirmedSuccessorBaselines         IdentityBaseline[]  @relation("IdentityBaselineConfirmationSource")
  supersedesIdentityBaselineId        String?
  supersedesIdentityBaseline          IdentityBaseline?  @relation("IdentityBaselineConfirmationChronology", fields: [tenantId, consumerId, supersedesIdentityBaselineId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict, map: "identity_baseline_confirmation_predecessor_fkey")
  supersededByIdentityBaseline        IdentityBaseline?  @relation("IdentityBaselineConfirmationChronology")
  semanticSha256                      String?              @db.VarChar(64)
  expectedIdentityFactCount           Int?
  expectedCategoryCompletionCount     Int?
  expectedAccountReviewReceiptCount   Int?
  baselineSeriesKey  String
  version            Int
  status             IdentityBaselineStatus
  policyVersion      String
  inputSetSha256     String                 @db.VarChar(64)
  confirmedByActorId String?
  confirmedAt        DateTime?
  createdByActorId   String
  createdAt          DateTime               @default(now())

  facts                  IdentityFact[]
  correspondences        Correspondence[]
  correspondenceVersions CorrespondenceVersion[]
  packets                Packet[]
  artifacts              Artifact[]
  categoryCompletions    IdentityCategoryCompletion[]
  identityAssertions     IdentityCorrespondenceAssertion[]
  consumerAccountReviews ConsumerAccountReviewReceipt[]
  round0SourceCompleteness Round0SourceCompletenessEvidence[] @relation("Round0SourceCompletenessBaseline")
  confirmedAccountReviewMemberships IdentityBaselineAccountReviewMembership[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, reportVersionId, id])
  @@unique([tenantId, consumerId, reportVersionId, id, version, inputSetSha256], map: "identity_baseline_attestation_pin_key")
  @@unique([tenantId, consumerId, reportVersionId, extractionRunId, id, version, inputSetSha256], map: "identity_baseline_source_seal_pin_key")
  @@unique([tenantId, consumerId, reportVersionId, extractionRunId, id, inputSetSha256], map: "identity_baseline_round0_source_pin_key")
  @@unique([tenantId, consumerId, supersedesIdentityBaselineId], map: "identity_baseline_single_successor_key")
  @@unique([tenantId, consumerId, baselineSeriesKey, version])
  @@index([tenantId, consumerId, reportVersionId, status])
}

model IdentityFact {
  id                       String                     @id @default(cuid())
  tenantId                 String
  consumerId               String
  reportVersionId          String
  identityBaselineId       String
  baseline                 IdentityBaseline           @relation(fields: [tenantId, consumerId, reportVersionId, identityBaselineId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict)
  extractionRunId          String?
  extractionRun            ExtractionRun?             @relation("IdentityFactExtractionRun", fields: [tenantId, consumerId, reportVersionId, extractionRunId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict, map: "identity_fact_extraction_run_fkey")
  baselineInputSetSha256   String?                    @db.VarChar(64)
  factSeriesKey            String
  factOrdinal              Int
  bureau                   Bureau?
  factType                 IdentityFactType
  classification           IdentityFactClassification
  reviewCategory           IdentityReviewCategory?
  integritySha256          String?                    @db.VarChar(64)
  presence                 ObservationPresence
  valueCiphertext          Bytes?
  valueIv                  Bytes?
  valueAuthTag             Bytes?
  valueKeyVersion          String?
  valueAlgorithm           EncryptionAlgorithm?
  valueEnvelopeVersion     String?
  valueAadVersion          String?
  sourceLocatorToken       String
  normalizationRuleKey     String
  normalizationRuleVersion String
  createdAt                DateTime                   @default(now())

  priorDifferences   ReportDifference[] @relation("ReportDifferencePriorIdentityFact")
  currentDifferences ReportDifference[] @relation("ReportDifferenceCurrentIdentityFact")
  identityAssertions IdentityCorrespondenceAssertion[]

  @@unique([tenantId, consumerId, id])
  @@unique([tenantId, consumerId, identityBaselineId, factOrdinal])
  @@unique([tenantId, consumerId, identityBaselineId, factSeriesKey])
  @@unique([tenantId, consumerId, reportVersionId, identityBaselineId, factSeriesKey, id], map: "identity_fact_difference_pin_key")
  @@unique([tenantId, consumerId, reportVersionId, identityBaselineId, factSeriesKey, id, classification, integritySha256], map: "identity_fact_assertion_pin_key")
  @@unique([tenantId, consumerId, reportVersionId, extractionRunId, identityBaselineId, baselineInputSetSha256, factSeriesKey, id, classification, integritySha256], map: "identity_fact_source_seal_pin_key")
  @@index([tenantId, consumerId, identityBaselineId, factType, classification])
}

// Category-level Round 0 completion evidence. It can only say that a category
// was not applicable after a complete source review found no corresponding fact.
// Database triggers reject both a contradictory completion and a later fact.
model IdentityCategoryCompletion {
  id                               String                                @id @default(cuid())
  tenantId                         String
  consumerId                       String
  reportVersionId                  String
  extractionRunId                  String
  identityBaselineId               String
  identityBaselineVersion          Int
  baselineInputSetSha256           String                                @db.VarChar(64)
