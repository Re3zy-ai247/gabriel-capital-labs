# Gabriel Capital Labs — environment variables
# Copy real values into Vercel → Project Settings → Environment Variables.
# NEVER commit real secrets to git. This file is a template only.

# ---- Core ----
DATABASE_URL=                 # auto-filled when you add Vercel Postgres / Prisma Postgres
NEXTAUTH_SECRET=              # run: openssl rand -base64 32
NEXTAUTH_URL=                 # your live URL, e.g. https://gabriel-capital-labs.vercel.app

# ---- AI (required for premium AI letter refinement) ----
ANTHROPIC_API_KEY=            # sk-ant-...   from console.anthropic.com
LLM_MODEL=claude-opus-4-8     # optional override; defaults to claude-opus-4-8

# ---- Stripe billing ----
# Only these are needed. The app uses Stripe-hosted Checkout, so NO publishable
# key is required (nothing client-side ever touches Stripe.js).
STRIPE_SECRET_KEY=                    # sk_test_... (test) or sk_live_... (live)   [REQUIRED]
STRIPE_WEBHOOK_SECRET=                # whsec_...  from the webhook endpoint you create  [REQUIRED]
STRIPE_TOS_CONSENT=                   # "1" = require ToS acceptance at Checkout. DEFAULT OFF.
                                      # PRECONDITION: Stripe Dashboard -> Settings -> Public details
                                      # must have BOTH a Terms of Service URL and a Privacy Policy URL.
                                      # Without them Stripe REJECTS every session ("You cannot collect
                                      # consent to your terms of service unless a URL is set"), which
                                      # would take checkout down. Set the URLs first, then flip this.

# ---- Identity document storage (encrypted at rest) ----
# 32-byte hex key for AES-256-GCM encryption of uploaded ID / proof documents.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, document upload is disabled (routes return 503) — nothing else breaks.
DOCUMENT_ENCRYPTION_KEY=

# ---- One-time account bootstrap (see /api/admin/bootstrap) ----
# ⚠️ Set ONLY while running the first-time bootstrap, then DELETE it from the
# environment — leaving it set keeps a privileged escalation path alive.
ADMIN_EMAIL=admin@gabrielcapitallabs.com
ADMIN_PASSWORD=               # the admin login password you want to use

# ---- Admin email alerts (OPTIONAL — community moderation queue) ----
# When set, the app emails ADMIN_EMAIL when the report queue goes from empty to
# non-empty (first open report). If unset, alerting silently no-ops — the in-app
# badge still works. Uses Resend's HTTP API (no SDK). RESEND_FROM must be a domain
# you've verified in the Resend dashboard.
RESEND_API_KEY=               # re_...  from resend.com  (leave blank to disable email)
RESEND_FROM=                  # e.g. "CreditVector Alerts <alerts@creditvector.app>" (verified domain)
RESEND_REPLY_TO=              # a real monitored inbox for replies (defaults to ADMIN_EMAIL); modest deliverability boost

# ---- Web Push / PWA phone notifications (OPTIONAL) ----
# Generate a pair with: npx web-push generate-vapid-keys
# If unset, the "Enable phone alerts" toggle reports unsupported and sends no-op.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=  # public VAPID key (safe to expose to the browser)
VAPID_PRIVATE_KEY=            # private VAPID key (secret)
VAPID_SUBJECT=mailto:no-reply@creditvector.app

# ---- Scheduled jobs (vercel.json crons: Brief ingest + weekly digest) ----
# Vercel sends `Authorization: Bearer <CRON_SECRET>` on cron invocations; the
# routes refuse to run (503) when it's unset, so set it in prod.
CRON_SECRET=                  # any long random string

# ---- Company legal identity / CAN-SPAM ----
# The stable legal name and postal footer are version-controlled server-side in
# lib/companyIdentity.server.ts. Do not duplicate them in environment variables,
# and never create a NEXT_PUBLIC_* company-identity or address variable.
