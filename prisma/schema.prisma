  @@unique([tenantId, consumerId, sourceSeriesKey, version], map: "identity_correspondence_source_series_version_key")
  @@unique([tenantId, consumerId, supersedesAssertionId], map: "identity_correspondence_single_successor_key")
  @@index([tenantId, consumerId, identityBaselineId, identityFactId, attestedAt], map: "identity_correspondence_fact_idx")
}

// Bounded consumer recognition review for one exact source-listed account.
// UNRECOGNIZED means only that the consumer did not recognize the account; no
// fraud, inaccuracy, dispute, deletion, policy, or legal conclusion is stored.
model ConsumerAccountReviewReceipt {
  id                                 String                         @id @default(cuid())
  tenantId                           String
  consumerId                         String
  scope                              CreditTruthScope               @relation(fields: [tenantId, consumerId], references: [tenantId, consumerId], onDelete: Restrict, onUpdate: Restrict)
  reportVersionId                    String
  reportVersion                      ReportVersion                  @relation(fields: [tenantId, consumerId, reportVersionId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict, map: "consumer_account_review_report_fkey")
  extractionRunId                    String
  extractionRun                      ExtractionRun                  @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict, map: "consumer_account_review_run_fkey")
  identityBaselineId                 String
  identityBaselineVersion            Int
  baselineInputSetSha256             String                         @db.VarChar(64)
  identityBaseline                   IdentityBaseline               @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId, identityBaselineId, identityBaselineVersion, baselineInputSetSha256], references: [tenantId, consumerId, reportVersionId, extractionRunId, id, version, inputSetSha256], onDelete: Restrict, onUpdate: Restrict, map: "consumer_account_review_baseline_fkey")
  bureau                             Bureau
  accountId                          String
  account                            Account                        @relation(fields: [tenantId, consumerId, accountId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict, map: "consumer_account_review_account_fkey")
  reportVersionAccountId             String
  reportVersionAccount               ReportVersionAccount           @relation(fields: [tenantId, consumerId, reportVersionId, reportVersionAccountId, accountId], references: [tenantId, consumerId, reportVersionId, id, accountId], onDelete: Restrict, onUpdate: Restrict, map: "consumer_account_review_report_account_fkey")
  accountPresenceObservationId       String
  accountPresenceObservationRevision Int
  accountPresenceIntegritySha256     String                         @db.VarChar(64)
  accountPresenceSourceLocatorToken  String
  accountPresenceObservation         AccountPresenceObservation     @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, accountId, accountPresenceObservationId, accountPresenceObservationRevision, accountPresenceIntegritySha256], references: [tenantId, consumerId, reportVersionId, extractionRunId, bureau, accountId, id, revision, integritySha256], onDelete: Restrict, onUpdate: Restrict, map: "consumer_account_review_presence_fkey")
  accountIndexCompletenessEvidenceId String
  accountIndexSourceMembershipSha256 String                         @db.VarChar(64)
  accountIndexCompletenessIntegritySha256 String                    @db.VarChar(64)
  accountIndexCompletenessEvidence   Round0SourceCompletenessEvidence @relation(fields: [tenantId, consumerId, accountIndexCompletenessEvidenceId, accountIndexSourceMembershipSha256, accountIndexCompletenessIntegritySha256], references: [tenantId, consumerId, id, sourceMembershipSha256, integritySha256], onDelete: Restrict, onUpdate: Restrict, map: "consumer_account_review_completeness_fkey")
  sourceSeriesKey                    String                         @db.VarChar(64)
  reviewSeriesKey                    String
  version                            Int
  reviewState                        ConsumerAccountReviewState
  sourceSetSha256                    String                         @db.VarChar(64)
  authorizationKind                  P0AuthorizationKind
  authorizationVersion               String
  reviewedByActorId                  String
  reviewedAt                         DateTime
  supersedesReviewId                 String?
  supersedes                         ConsumerAccountReviewReceipt?  @relation("ConsumerAccountReviewSupersession", fields: [tenantId, consumerId, reviewSeriesKey, supersedesReviewId], references: [tenantId, consumerId, reviewSeriesKey, id], onDelete: Restrict, onUpdate: Restrict, map: "consumer_account_review_supersession_fkey")
  supersededBy                       ConsumerAccountReviewReceipt[] @relation("ConsumerAccountReviewSupersession")
  confirmedBaselineMemberships       IdentityBaselineAccountReviewMembership[]
  createdAt                          DateTime                       @default(now())

  @@unique([tenantId, consumerId, id], map: "consumer_account_review_scope_id_key")
  @@unique([tenantId, consumerId, reviewSeriesKey, id], map: "consumer_account_review_supersession_key")
  @@unique([tenantId, consumerId, reviewSeriesKey, version], map: "consumer_account_review_series_version_key")
  @@unique([tenantId, consumerId, sourceSeriesKey, version], map: "consumer_account_review_source_series_version_key")
  @@unique([tenantId, consumerId, supersedesReviewId], map: "consumer_account_review_single_successor_key")
  @@unique([tenantId, consumerId, id, reviewSeriesKey, version, reviewState, sourceSetSha256, bureau, accountId, reportVersionAccountId], map: "consumer_account_review_confirmation_pin_key")
  @@index([tenantId, consumerId, reportVersionId, extractionRunId, bureau, accountId, reviewedAt], map: "consumer_account_review_source_idx")
}

// Exact normalized membership of a current consumer account-review receipt in
// one immutable CONFIRMED Round-0 baseline. This is refs-only confirmation
// evidence; it carries no fraud, accuracy, dispute, policy, or legal conclusion.
model IdentityBaselineAccountReviewMembership {
  id                                String                         @id @default(cuid())
  tenantId                          String
  consumerId                        String
  scope                             CreditTruthScope               @relation(fields: [tenantId, consumerId], references: [tenantId, consumerId], onDelete: Restrict, onUpdate: Restrict, map: "identity_baseline_account_review_scope_fkey")
  reportVersionId                   String
  reportVersion                     ReportVersion                  @relation(fields: [tenantId, consumerId, reportVersionId], references: [tenantId, consumerId, id], onDelete: Restrict, onUpdate: Restrict, map: "identity_baseline_account_review_report_fkey")
  extractionRunId                   String
  extractionRun                     ExtractionRun                  @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId], references: [tenantId, consumerId, reportVersionId, id], onDelete: Restrict, onUpdate: Restrict, map: "identity_baseline_account_review_run_fkey")
  confirmedIdentityBaselineId       String
  confirmedIdentityBaselineVersion  Int
  confirmedBaselineInputSetSha256   String                         @db.VarChar(64)
  confirmedIdentityBaseline         IdentityBaseline               @relation(fields: [tenantId, consumerId, reportVersionId, extractionRunId, confirmedIdentityBaselineId, confirmedIdentityBaselineVersion, confirmedBaselineInputSetSha256], references: [tenantId, consumerId, reportVersionId, extractionRunId, id, version, inputSetSha256], onDelete: Restrict, onUpdate: Restrict, map: "identity_baseline_account_review_baseline_fkey")
  consumerAccountReviewReceiptId    String
  reviewSeriesKey                   String
  reviewVersion                     Int
  reviewState                       ConsumerAccountReviewState
  receiptSourceSetSha256            String                         @db.VarChar(64)
  bureau                            Bureau
  accountId                         String
  reportVersionAccountId            String
  consumerAccountReviewReceipt      ConsumerAccountReviewReceipt   @relation(fields: [tenantId, consumerId, consumerAccountReviewReceiptId, reviewSeriesKey, reviewVersion, reviewState, receiptSourceSetSha256, bureau, accountId, reportVersionAccountId], references: [tenantId, consumerId, id, reviewSeriesKey, version, reviewState, sourceSetSha256, bureau, accountId, reportVersionAccountId], onDelete: Restrict, onUpdate: Restrict, map: "identity_baseline_account_review_receipt_fkey")
  ordinal                           Int
  createdAt                         DateTime                        @default(now())

  @@unique([tenantId, consumerId, id], map: "identity_baseline_account_review_scope_id_key")
